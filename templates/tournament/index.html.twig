{% extends 'base.html.twig' %}

{% block title %}Torneos de Padel - RxUp{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-8 md:py-12 px-4 sm:px-6 lg:px-8">

        {# Cabecera de la Sección - Ahora más limpia #}
        <div class="mb-10">
            <span class="text-indigo-600 font-black text-[10px] uppercase tracking-[0.3em] mb-1 block">Competiciones</span>
            <h1 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tighter uppercase leading-none">Explorar</h1>
            <p class="text-gray-500 text-xs font-medium mt-2 uppercase tracking-wide italic">Consulta el calendario y la clasificación de las ligas activas.</p>
        </div>

        {# Grid de Torneos #}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            {% for tournament in tournaments %}
                <div class="group relative bg-white rounded-[2.5rem] shadow-[0_15px_40px_rgba(0,0,0,0.04)] overflow-hidden border border-gray-100 hover:shadow-[0_25px_60px_rgba(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-1">

                    {# Etiqueta de Tipo #}
                    <div class="absolute top-6 right-6 z-10">
                    <span class="px-3 py-1.5 text-[9px] font-black uppercase tracking-widest rounded-xl shadow-sm border {{ tournament.type == 'LEAGUE' ? 'bg-blue-50 text-blue-600 border-blue-100' : 'bg-purple-50 text-purple-600 border-purple-100' }}">
                        {{ tournament.type == 'LEAGUE' ? '🏆 Liga' : '🎾 Torneo' }}
                    </span>
                    </div>

                    <div class="p-8">
                        {# Icono Dinámico #}
                        <div class="mb-6 h-14 w-14 bg-gray-50 rounded-2xl flex items-center justify-center text-gray-300 group-hover:bg-indigo-50 group-hover:text-indigo-500 transition-colors duration-500">
                            <i class="fas {{ tournament.type == 'LEAGUE' ? 'fa-trophy' : 'fa-medal' }} text-2xl"></i>
                        </div>

                        <h2 class="text-2xl font-black text-gray-900 uppercase tracking-tighter leading-tight group-hover:text-indigo-600 transition-colors">
                            {{ tournament.name }}
                        </h2>

                        <p class="text-gray-500 mt-4 text-xs font-medium leading-relaxed line-clamp-3 uppercase tracking-tight">
                            {{ tournament.description ?: 'No hay descripción disponible para esta competición.' }}
                        </p>

                        <div class="mt-8">
                            <a href="{{ path('app_tournament_show', {id: tournament.id}) }}" class="w-full inline-flex items-center justify-center bg-gray-900 text-white font-black py-4 px-6 rounded-2xl text-[10px] uppercase tracking-[0.2em] group-hover:bg-indigo-600 transition-all duration-500 shadow-xl shadow-gray-200 group-hover:shadow-indigo-100">
                                Ver Competición <i class="fas fa-chevron-right ml-2 text-[8px] transform group-hover:translate-x-1 transition-transform"></i>
                            </a>
                        </div>
                    </div>

                    {# Decoración estética inferior #}
                    <div class="h-1.5 w-full {{ tournament.type == 'LEAGUE' ? 'bg-blue-500' : 'bg-purple-500' }} opacity-20"></div>
                </div>
            {% else %}
                {# Empty State #}
                <div class="col-span-full text-center py-24 bg-white rounded-[3rem] border-2 border-dashed border-gray-100">
                    <div class="h-20 w-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-calendar-times text-gray-200 text-3xl"></i>
                    </div>
                    <h3 class="text-gray-900 font-black uppercase text-sm tracking-widest">Sin competiciones</h3>
                    <p class="text-gray-400 text-xs font-medium mt-2">Vuelve pronto para inscribirte en nuevos torneos.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
