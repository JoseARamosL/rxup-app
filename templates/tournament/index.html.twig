{% extends 'base.html.twig' %}

{% block title %}Explorar Competiciones - RxUp{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-8 md:py-12 px-4 sm:px-6 lg:px-8">

        {# Cabecera Estilo Urbano #}
        <div class="mb-12 relative">
            <div class="absolute -left-4 top-0 w-1 h-12 bg-[#e63946] rounded-full hidden md:block"></div>
            <span class="text-[#e63946] font-black text-[10px] uppercase tracking-[0.4em] mb-2 block ml-1">Live Tournaments</span>
            <h1 class="text-5xl md:text-6xl font-black text-[#e2d9c2] tracking-tighter uppercase italic leading-none">
                Explorar
            </h1>
            <p class="text-gray-500 text-[10px] font-bold mt-3 uppercase tracking-widest max-w-md">
                Domina la pista. Consulta calendarios y rankings de las ligas activas en <span class="text-[#e2d9c2]">RXUP</span>.
            </p>
        </div>

        {# Grid de Torneos #}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
            {% for tournament in tournaments %}
                <div class="group relative bg-[#1a1a1a] rounded-[2.5rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden border border-white/5 hover:border-[#e63946]/30 transition-all duration-500 hover:-translate-y-2">

                    {# Badge Flotante #}
                    <div class="absolute top-6 right-6 z-10">
                        <span class="px-3 py-1.5 text-[9px] font-black uppercase tracking-widest rounded-xl shadow-lg backdrop-blur-md border {{ tournament.type == 'LEAGUE' ? 'bg-blue-500/10 text-blue-400 border-blue-500/20' : 'bg-[#e63946]/10 text-[#e63946] border-[#e63946]/20' }}">
                            {{ tournament.type == 'LEAGUE' ? '🏆 Liga' : '🎾 Torneo' }}
                        </span>
                    </div>

                    <div class="p-10">
                        {# Icono de Fondo con Resplandor #}
                        <div class="mb-8 h-16 w-16 bg-[#252525] rounded-2xl flex items-center justify-center text-gray-500 group-hover:bg-[#e63946] group-hover:text-white transition-all duration-500 shadow-inner">
                            <i class="fas {{ tournament.type == 'LEAGUE' ? 'fa-trophy' : 'fa-bolt' }} text-2xl"></i>
                        </div>

                        <h2 class="text-3xl font-black text-[#e2d9c2] uppercase tracking-tighter leading-none group-hover:text-white transition-colors italic">
                            {{ tournament.name }}
                        </h2>

                        <p class="text-gray-500 mt-5 text-xs font-medium leading-relaxed line-clamp-2 uppercase tracking-tight">
                            {{ tournament.description ?: 'Prepárate para la máxima intensidad en la pista.' }}
                        </p>

                        <div class="mt-10">
                            <a href="{{ path('app_tournament_show', {id: tournament.id}) }}" class="w-full inline-flex items-center justify-center bg-[#252525] text-[#e2d9c2] font-black py-5 px-6 rounded-2xl text-[10px] uppercase tracking-[0.3em] group-hover:bg-[#e63946] group-hover:text-white transition-all duration-500 shadow-xl group-hover:shadow-[#e63946]/20">
                                Entrar a la Arena <i class="fas fa-arrow-right ml-3 text-[10px] transform group-hover:translate-x-2 transition-transform"></i>
                            </a>
                        </div>
                    </div>

                    {# Línea de energía inferior (Rojo RXUP) #}
                    <div class="h-2 w-full bg-[#e63946] transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
                </div>
            {% else %}
                {# Empty State Dark #}
                <div class="col-span-full text-center py-28 bg-[#1a1a1a] rounded-[3rem] border-2 border-dashed border-white/5">
                    <div class="h-24 w-24 bg-[#252525] rounded-full flex items-center justify-center mx-auto mb-8 shadow-inner">
                        <i class="fas fa-ghost text-gray-700 text-4xl"></i>
                    </div>
                    <h3 class="text-[#e2d9c2] font-black uppercase text-base tracking-[0.2em]">Pista Vacía</h3>
                    <p class="text-gray-600 text-xs font-bold mt-3 uppercase tracking-widest">No hay competiciones activas. Calienta, pronto habrá acción.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
