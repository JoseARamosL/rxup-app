{% extends 'base.html.twig' %}

{% block title %}{{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto py-8 px-4 sm:px-6 lg:px-8">

    {# Cabecera del Torneo #}
    <div class="mb-8">
        <div class="flex items-center gap-2 text-indigo-600 font-bold text-sm uppercase tracking-widest mb-2">
            <span>{{ tournament.type == 'LEAGUE' ? '🏆 Liga' : '🎾 Torneo' }}</span>
            {% if tournament.isActive %}
                <span class="bg-green-100 text-green-700 px-2 py-0.5 rounded-full text-[10px]">En curso</span>
            {% endif %}
        </div>
        <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">{{ tournament.name }}</h1>
    </div>

    {# Pestañas (Tabs) con Alpine.js o CSS Simple. Aquí usaremos un sistema limpio de botones #}
    <div x-data="{ tab: 'calendar' }" class="space-y-6">
        <div class="flex p-1 bg-gray-100 rounded-2xl sm:w-max">
            <button @click="tab = 'calendar'" :class="tab === 'calendar' ? 'bg-white shadow-sm text-indigo-600' : 'text-gray-500 hover:text-gray-700'" class="px-6 py-2.5 rounded-xl text-sm font-bold transition-all duration-200">
                Calendario
            </button>
            {% if tournament.hasRanking %}
            <button @click="tab = 'ranking'" :class="tab === 'ranking' ? 'bg-white shadow-sm text-indigo-600' : 'text-gray-500 hover:text-gray-700'" class="px-6 py-2.5 rounded-xl text-sm font-bold transition-all duration-200">
                Clasificación
            </button>
            {% endif %}
            <button @click="tab = 'rules'" :class="tab === 'rules' ? 'bg-white shadow-sm text-indigo-600' : 'text-gray-500 hover:text-gray-700'" class="px-6 py-2.5 rounded-xl text-sm font-bold transition-all duration-200">
                Normativa
            </button>
        </div>

        {# SECCIÓN CALENDARIO (Con Acordeones) #}
        <div x-show="tab === 'calendar'" class="space-y-4 animate-fade-in">
            {% for phase, phaseGames in groupedGames %}
                {# Cada fase es un acordeón independiente. 'open' controla si empieza abierto o cerrado #}
                <div x-data="{ open: {{ loop.first ? 'true' : 'false' }} }" class="bg-white rounded-[2rem] shadow-sm border border-gray-100 overflow-hidden transition-all duration-300">

                    {# Cabecera del Acordeón (Clickable) #}
                    <button @click="open = !open"
                            class="w-full flex items-center justify-between px-8 py-5 bg-gray-50/50 hover:bg-gray-50 transition-colors group">
                        <div class="flex items-center gap-4">
                            <span class="flex items-center justify-center w-8 h-8 rounded-full bg-indigo-100 text-indigo-600 text-[10px] font-black">
                                {{ loop.index }}
                            </span>
                            <h3 class="font-black text-gray-700 uppercase text-xs tracking-[0.2em]">{{ phase }}</h3>
                        </div>

                        {# Icono indicador (Flecha que gira) #}
                        <div class="text-gray-300 group-hover:text-indigo-500 transition-all duration-300"
                            :class="open ? 'rotate-180' : ''">
                            <i class="fas fa-chevron-down text-xs"></i>
                        </div>
                    </button>

                    {# Contenido del Acordeón (Partidos) #}
                    <div x-show="open"
                        x-collapse
                        x-transition:enter="transition ease-out duration-300"
                        x-transition:enter-start="opacity-0 transform -translate-y-2"
                        x-transition:enter-end="opacity-100 transform translate-y-0"
                        class="divide-y divide-gray-50 border-t border-gray-100">

                        {% for game in phaseGames %}
                            <div class="p-6 flex flex-col md:flex-row items-center justify-between gap-6 hover:bg-gray-50/30 transition-colors">
                                <div class="flex items-center space-x-4 md:space-x-12 text-center">

                                    {# Pareja Local #}
                                    <div class="w-40">
                                        {% if game.team1 %}
                                            <p class="font-black text-gray-900 text-sm uppercase tracking-tighter">{{ game.team1.player1.name }}</p>
                                            <p class="font-bold text-indigo-500 text-[11px] uppercase tracking-tighter">{{ game.team1.player2.name }}</p>
                                        {% else %}
                                            <p class="text-gray-400 italic text-sm font-bold">TBD</p>
                                        {% endif %}
                                    </div>

                                    {# Score / VS #}
                                    <div class="flex flex-col items-center min-w-[100px]">
                                        {% if game.score %}
                                            <div class="bg-gray-900 text-white px-4 py-1.5 rounded-xl font-mono text-lg shadow-lg border-b-2 border-indigo-500">
                                                {{ game.score }}
                                            </div>
                                        {% else %}
                                            <div class="text-indigo-100 font-black text-2xl italic px-4">VS</div>
                                        {% endif %}
                                        <span class="text-[9px] uppercase font-black text-gray-400 mt-2 tracking-widest">
                                            {{ game.date ? game.date|date('d/m H:i') : 'Por definir' }}
                                        </span>
                                    </div>

                                    {# Pareja Visitante #}
                                    <div class="w-40">
                                        {% if game.team2 %}
                                            <p class="font-black text-gray-900 text-sm uppercase tracking-tighter">{{ game.team2.player1.name }}</p>
                                            <p class="font-bold text-indigo-500 text-[11px] uppercase tracking-tighter">{{ game.team2.player2.name }}</p>
                                        {% else %}
                                            <p class="text-gray-400 italic text-sm font-bold">TBD</p>
                                        {% endif %}
                                    </div>
                                </div>

                                {# Detalles extra #}
                                <div class="flex items-center gap-3">
                                    <div class="text-[10px] text-gray-400 bg-gray-50 px-4 py-1.5 rounded-xl border border-gray-100 font-black uppercase tracking-widest">
                                        Pista: {{ game.court|default('Principal') }}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="text-center py-20 bg-white rounded-[3rem] border-2 border-dashed border-gray-100">
                    <i class="fas fa-calendar-alt text-4xl text-gray-100 mb-4 block"></i>
                    <p class="text-gray-400 font-medium italic">No hay partidos programados todavía.</p>
                </div>
            {% endfor %}
        </div>

        {# SECCIÓN CLASIFICACIÓN #}
        {% if tournament.hasRanking %}
        <div x-show="tab === 'ranking'" class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden animate-fade-in">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50 text-[10px] font-bold text-gray-400 uppercase tracking-tighter">
                        <tr>
                            <th class="px-6 py-4 text-left">Pareja</th>
                            <th class="px-2 py-4">Pts</th>
                            <th class="px-2 py-4">PJ</th>
                            <th class="px-2 py-4">PG</th>
                            <th class="px-2 py-4">DF</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 text-sm">
                        {% for team, data in stats %}
                            <tr class="{{ loop.index <= 3 ? 'bg-indigo-50/20' : '' }}">
                                <td class="px-6 py-4 font-bold text-gray-900">
                                    <span class="text-gray-300 mr-2 italic">{{ loop.index }}º</span> {{ team }}
                                </td>
                                <td class="px-2 py-4 text-center font-black text-indigo-600">{{ data.points }}</td>
                                <td class="px-2 py-4 text-center text-gray-500">{{ data.pj }}</td>
                                <td class="px-2 py-4 text-center text-gray-500">{{ data.pg }}</td>
                                <td class="px-2 py-4 text-center font-bold {{ data.df >= 0 ? 'text-green-600' : 'text-red-400' }}">
                                    {{ data.df > 0 ? '+' : '' }}{{ data.df }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endif %}

        {# SECCIÓN NORMATIVA #}
        <div x-show="tab === 'rules'" class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100 prose max-w-none animate-fade-in">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Normas del Torneo</h2>
            <div class="text-gray-600 leading-relaxed whitespace-pre-wrap">
                {{ tournament.description ?: 'No se ha especificado normativa para este torneo.' }}
            </div>
        </div>
    </div>
</div>

{# Incluimos Alpine.js para que las pestañas funcionen sin recargar #}
<script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
{% endblock %}
