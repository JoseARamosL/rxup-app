{% extends 'base.html.twig' %}

{% block title %}{{ tournament.name }} - RXUP{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto py-6 md:py-10 px-4 sm:px-6 lg:px-8">

        {# Cabecera del Torneo #}
        <div class="mb-10">
            <div class="flex items-center gap-3 text-[#e63946] font-black text-[10px] uppercase tracking-[0.3em] mb-4">
                <span class="bg-[#e63946] text-white px-3 py-1 rounded-lg shadow-lg shadow-[#e63946]/20">
                    {{ tournament.type == 'LEAGUE' ? '🏆 LIGA' : '🎾 TORNEO' }}
                </span>
                {% if tournament.isActive %}
                    <span class="flex items-center gap-1.5 text-emerald-500 bg-emerald-500/10 px-3 py-1 rounded-lg border border-emerald-500/20">
                        <span class="h-1.5 w-1.5 bg-emerald-500 rounded-full animate-pulse"></span> LIVE
                    </span>
                {% endif %}
            </div>
            <h1 class="text-4xl md:text-6xl font-black text-[#e2d9c2] tracking-tighter uppercase italic leading-none">{{ tournament.name }}</h1>
        </div>

        {# Pestañas (Tabs) Estilo Pro #}
        <div x-data="{ tab: 'calendar' }" class="space-y-8">
            {# Contenedor con scroll horizontal opcional para móviles muy pequeños #}
            <div class="overflow-x-auto pb-2 sm:pb-0 hide-scrollbar">
                <div class="flex p-1 bg-[#1a1a1a] rounded-[1.5rem] md:rounded-[2rem] w-full sm:w-max border border-white/5 shadow-2xl min-w-[340px]">

                    <button @click="tab = 'calendar'"
                            :class="tab === 'calendar' ? 'bg-[#e63946] text-white shadow-xl' : 'text-gray-500'"
                            class="flex-1 sm:flex-none px-3 md:px-8 py-3 md:py-4 rounded-xl md:rounded-2xl text-[9px] md:text-[10px] font-black uppercase tracking-tighter md:tracking-widest transition-all duration-300">
                        Calendario
                    </button>

                    {% if tournament.hasRanking %}
                        <button @click="tab = 'ranking'"
                                :class="tab === 'ranking' ? 'bg-[#e63946] text-white shadow-xl' : 'text-gray-500'"
                                class="flex-1 sm:flex-none px-3 md:px-8 py-3 md:py-4 rounded-xl md:rounded-2xl text-[9px] md:text-[10px] font-black uppercase tracking-tighter md:tracking-widest transition-all duration-300">
                            Ranking
                        </button>
                    {% endif %}

                    <button @click="tab = 'rules'"
                            :class="tab === 'rules' ? 'bg-[#e63946] text-white shadow-xl' : 'text-gray-500'"
                            class="flex-1 sm:flex-none px-3 md:px-8 py-3 md:py-4 rounded-xl md:rounded-2xl text-[9px] md:text-[10px] font-black uppercase tracking-tighter md:tracking-widest transition-all duration-300">
                        Normas
                    </button>
                </div>
            </div>

            {# SECCIÓN CALENDARIO #}
            <div x-show="tab === 'calendar'" class="space-y-6 animate-fade-in">
                {% for phase, phaseGames in groupedGames %}
                    <div x-data="{ open: {{ loop.first ? 'true' : 'false' }} }" class="bg-[#1a1a1a] rounded-[2.5rem] border border-white/5 overflow-hidden transition-all duration-300 shadow-2xl">
                        <button @click="open = !open" class="w-full flex items-center justify-between px-8 py-6 bg-white/5 hover:bg-white/10 transition-colors group">
                            <div class="flex items-center gap-5">
                                <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#e63946] text-white text-[10px] font-black shadow-lg shadow-[#e63946]/20">
                                    {{ loop.index }}
                                </span>
                                <h3 class="font-black text-[#e2d9c2] uppercase text-xs tracking-[0.2em] italic">{{ phase }}</h3>
                            </div>
                            <i class="fas fa-chevron-down text-gray-600 text-xs transition-transform duration-300" :class="open ? 'rotate-180 text-[#e63946]' : ''"></i>
                        </button>

                        <div x-show="open" x-collapse class="divide-y divide-white/5 border-t border-white/5">
                            {% for game in phaseGames %}
                                <div class="p-6 md:p-10 flex flex-col md:flex-row items-center justify-between gap-8 hover:bg-white/[0.02] transition-colors">
                                    <div class="flex items-center justify-between w-full md:w-auto md:space-x-16 text-center">
                                        {# Pareja Local #}
                                        <div class="flex-1 md:w-44">
                                            {% if game.team1 %}
                                                <p class="font-black text-[#e2d9c2] text-xs md:text-sm uppercase tracking-tight">{{ game.team1.player1.name }}</p>
                                                <p class="font-black text-[#e2d9c2] text-xs md:text-sm uppercase tracking-tight opacity-70">{{ game.team1.player2.name }}</p>
                                            {% else %}
                                                <p class="text-gray-600 italic text-xs font-bold">PDTE</p>
                                            {% endif %}
                                        </div>

                                        {# SCORE / VS #}
                                        <div class="flex flex-col items-center px-4">
                                            {% if game.score %}
                                                <div class="bg-[#e63946] text-white px-5 py-2 rounded-xl font-mono text-xl shadow-xl shadow-[#e63946]/20 italic font-black">
                                                    {{ game.score }}
                                                </div>
                                            {% else %}
                                                <div class="text-white/10 font-black text-3xl italic tracking-tighter">VS</div>
                                            {% endif %}
                                            <span class="text-[8px] uppercase font-black text-gray-500 mt-3 tracking-[0.3em]">
                                                {{ game.date ? game.date|date('d/m H:i') : 'TBD' }}
                                            </span>
                                        </div>

                                        {# Pareja Visitante #}
                                        <div class="flex-1 md:w-44">
                                            {% if game.team2 %}
                                                <p class="font-black text-[#e2d9c2] text-xs md:text-sm uppercase tracking-tight">{{ game.team2.player1.name }}</p>
                                                <p class="font-black text-[#e2d9c2] text-xs md:text-sm uppercase tracking-tight opacity-70">{{ game.team2.player2.name }}</p>
                                            {% else %}
                                                <p class="text-gray-600 italic text-xs font-bold">PDTE</p>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <div class="w-full md:w-auto text-center">
                                        <span class="text-[9px] text-gray-400 font-black uppercase tracking-widest bg-[#252525] px-5 py-2.5 rounded-xl border border-white/5 shadow-inner">
                                            Pista: {{ game.court|default('TBD') }}
                                        </span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            {# SECCIÓN CLASIFICACIÓN #}
            {% if tournament.hasRanking %}
                <div x-show="tab === 'ranking'" class="animate-fade-in space-y-6">

                    {# LEYENDA RXUP #}
                    <div class="bg-[#1a1a1a] border border-white/5 rounded-2xl p-5 flex flex-wrap justify-center md:justify-start gap-x-8 gap-y-3 shadow-2xl">
                        {% for key, label in {'#e63946': 'Pts', 'gray-500': 'PJ', 'emerald-500': 'PG', 'amber-500': 'PE', 'red-400': 'PP', 'blue-400': 'DF'} %}
                            <div class="flex items-center gap-2.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-{{ label == 'Pts' ? '[#e63946]' : key }}"></span>
                                <span class="text-[9px] font-black text-gray-500 uppercase tracking-widest">{{ label }}</span>
                            </div>
                        {% endfor %}
                    </div>

                    {# TABLA RANKING #}
                    <div class="bg-[#1a1a1a] rounded-[2.5rem] shadow-2xl border border-white/5 overflow-hidden">
                        <table class="w-full border-collapse">
                            <thead class="bg-white/5 text-[9px] md:text-[10px] font-black text-gray-500 uppercase tracking-widest border-b border-white/5">
                            <tr>
                                <th class="pl-6 pr-2 md:px-10 py-6 text-left italic">Pareja</th>
                                <th class="px-2 py-6 text-center">Pts</th>
                                <th class="hidden md:table-cell px-2 py-6 text-center opacity-50">PJ</th>
                                <th class="hidden md:table-cell px-2 py-6 text-center text-emerald-500/70">PG</th>
                                <th class="hidden md:table-cell px-2 py-6 text-center text-amber-500/70">PE</th>
                                <th class="hidden md:table-cell px-2 py-6 text-center text-red-400/70">PP</th>
                                <th class="md:hidden px-2 py-6 text-center italic text-gray-600">G/E/P</th>
                                <th class="px-2 py-6 text-center">Juegos</th>
                                <th class="pr-6 pl-2 md:px-8 py-6 bg-white/5 text-[#e2d9c2] text-center">DF</th>
                            </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                            {% for team, data in stats %}
                                <tr class="{{ loop.index <= 3 ? 'bg-[#e63946]/5' : '' }} hover:bg-white/[0.03] transition-colors">
                                    <td class="pl-6 pr-2 md:px-10 py-5">
                                        <div class="flex items-center">
                                                <span class="text-xs font-black {{ loop.index <= 3 ? 'text-[#e63946]' : 'text-gray-700' }} mr-4 md:mr-6 w-5 italic">
                                                    {{ loop.index }}º
                                                </span>
                                            <div class="leading-tight min-w-0">
                                                {% set players = team|split('/') %}
                                                <p class="text-[10px] md:text-xs font-black text-[#e2d9c2] uppercase tracking-tight truncate">{{ players[0]|trim }}</p>
                                                <p class="text-[10px] md:text-xs font-black text-[#e2d9c2] uppercase tracking-tight truncate opacity-50">{{ players[1]|default('')|trim }}</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-1 md:px-4 py-5 text-center">
                                            <span class="inline-flex items-center justify-center bg-[#e63946] text-white w-9 h-9 md:w-11 md:h-11 rounded-xl text-[11px] md:text-sm font-black shadow-lg shadow-[#e63946]/20 italic">
                                                {{ data.points }}
                                            </span>
                                    </td>
                                    <td class="hidden md:table-cell px-2 py-5 text-center text-xs font-bold text-gray-500">{{ data.pj }}</td>
                                    <td class="hidden md:table-cell px-2 py-5 text-center text-xs font-bold text-emerald-500">{{ data.pg }}</td>
                                    <td class="hidden md:table-cell px-2 py-5 text-center text-xs font-bold text-amber-500">{{ data.pe }}</td>
                                    <td class="hidden md:table-cell px-2 py-5 text-center text-xs font-bold text-red-400">{{ data.pp }}</td>

                                    <td class="md:hidden px-1 py-5 text-center">
                                        <div class="text-[10px] font-black text-[#e2d9c2]">{{ data.pj }}<span class="text-[8px] text-gray-600 ml-0.5">PJ</span></div>
                                        <div class="flex justify-center gap-1.5 text-[9px] font-black">
                                            <span class="text-emerald-500">{{ data.pg }}</span>
                                            <span class="text-amber-500">{{ data.pe }}</span>
                                            <span class="text-red-400">{{ data.pp }}</span>
                                        </div>
                                    </td>

                                    <td class="px-1 md:px-4 py-5 text-center">
                                        <div class="text-[9px] md:text-xs font-black leading-none">
                                            <span class="text-[#e2d9c2] block md:inline">{{ data.pf }}</span>
                                            <span class="hidden md:inline text-gray-700 mx-1">/</span>
                                            <span class="text-gray-500 block md:inline text-[8px] md:text-xs italic">{{ data.pc }}</span>
                                        </div>
                                    </td>

                                    <td class="pr-6 pl-2 md:px-8 py-5 text-center bg-white/5 font-black text-xs md:text-base italic {{ data.df > 0 ? 'text-emerald-500' : (data.df < 0 ? 'text-red-500' : 'text-gray-600') }}">
                                        {{ data.df > 0 ? '+' : '' }}{{ data.df }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}

            {# SECCIÓN NORMATIVA #}
            <div x-show="tab === 'rules'" class="bg-[#1a1a1a] rounded-[2.5rem] p-10 md:p-14 border border-white/5 animate-fade-in relative overflow-hidden shadow-2xl">
                <div class="absolute -right-16 -top-16 opacity-[0.03] rotate-12">
                    <i class="fas fa-shield-halved text-[20rem] text-white"></i>
                </div>
                <h2 class="text-2xl font-black text-[#e2d9c2] uppercase tracking-[0.3em] mb-8 flex items-center italic">
                    <span class="w-10 h-1 bg-[#e63946] mr-4 rounded-full"></span> Normas
                </h2>
                <div class="text-gray-400 text-sm md:text-base leading-relaxed whitespace-pre-wrap font-medium">
                    {{ tournament.description ?: 'No se ha especificado normativa oficial para este torneo.' }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
