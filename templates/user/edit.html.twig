{% extends 'base.html.twig' %}

{% block title %}Editar Jugador - RXUP{% endblock %}

{% block body %}
    <div class="min-h-screen md:min-h-[85vh] flex flex-col justify-center py-8 md:py-12 px-4 sm:px-6 lg:px-8 relative">

        {# Header Estilo RXUP #}
        <div class="sm:mx-auto sm:w-full sm:max-w-md relative z-10">
            <div class="flex justify-center mb-8">
                <div class="h-20 w-20 bg-[#e63946] rounded-[2rem] -rotate-3 flex items-center justify-center shadow-[0_15px_35px_rgba(230,57,70,0.3)] transition-transform hover:rotate-0 duration-500 group">
                    <i class="fas fa-user-edit text-white text-2xl rotate-3 group-hover:scale-110 transition-transform"></i>
                </div>
            </div>
            <h2 class="text-center text-4xl font-black text-[#e2d9c2] tracking-tighter uppercase italic leading-none">
                Editar <span class="text-[#e63946]">Perfil</span>
            </h2>
            <p class="mt-4 text-center text-[10px] font-black text-gray-500 uppercase tracking-[0.4em]">
                Actualizando a <span class="text-[#e2d9c2] italic underline decoration-[#e63946] underline-offset-4">{{ user.name }}</span>
            </p>
        </div>

        <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-md relative z-10">
            <div class="bg-[#1a1a1a] py-10 px-6 md:px-12 shadow-[0_40px_80px_rgba(0,0,0,0.6)] border border-white/5 rounded-[3rem]">

                {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

                {# Campo Nombre #}
                <div class="space-y-3">
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-2">Nombre y Apellidos</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <i class="fas fa-id-card text-gray-700 group-focus-within:text-[#e63946] transition-colors"></i>
                        </div>
                        {{ form_widget(form.name, {
                            'attr': {
                                'class': 'block w-full pl-12 pr-5 py-5 bg-[#252525] border-0 rounded-[1.5rem] text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] transition-all text-sm font-bold shadow-inner outline-none'
                            }
                        }) }}
                    </div>
                </div>

                {# Campo Email #}
                <div class="space-y-3">
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-2">Correo Electrónico</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <i class="fas fa-envelope text-gray-700 group-focus-within:text-[#e63946] transition-colors"></i>
                        </div>
                        {{ form_widget(form.email, {
                            'attr': {
                                'class': 'block w-full pl-12 pr-5 py-5 bg-[#252525] border-0 rounded-[1.5rem] text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] transition-all text-sm font-bold shadow-inner outline-none'
                            }
                        }) }}
                    </div>
                </div>

                {# Campo Teléfono #}
                <div class="space-y-3">
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-2">Teléfono de contacto</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <i class="fas fa-phone text-gray-700 group-focus-within:text-[#e63946] transition-colors"></i>
                        </div>
                        {{ form_widget(form.phone, {
                            'attr': {
                                'class': 'block w-full pl-12 pr-5 py-5 bg-[#252525] border-0 rounded-[1.5rem] text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] transition-all text-sm font-bold shadow-inner outline-none',
                                'placeholder': 'EJ: 600 000 000'
                            }
                        }) }}
                    </div>
                </div>

                {# Botón Guardar Principal #}
                <div class="pt-6">
                    <button type="submit" class="group w-full flex items-center justify-center py-6 px-4 rounded-[2rem] text-[11px] font-black text-white bg-[#e63946] hover:bg-[#ff4d5a] transition-all uppercase tracking-[0.4em] shadow-[0_20px_40px_rgba(230,57,70,0.3)] italic">
                        <i class="fas fa-save mr-3 group-hover:rotate-12 transition-transform"></i>
                        Actualizar Registro
                    </button>
                </div>

                {{ form_end(form) }}

                {# Acciones secundarias #}
                <div class="mt-12 pt-10 border-t border-white/5 space-y-6">
                    <a href="{{ path('app_user_index') }}" class="flex items-center justify-center w-full py-2 text-[10px] font-black text-gray-600 hover:text-[#e2d9c2] uppercase tracking-[0.3em] transition-all group">
                        <i class="fas fa-arrow-left mr-3 group-hover:-translate-x-2 transition-transform"></i> Volver a la Lista
                    </a>

                    {# Zona de Peligro #}
                    <div class="flex flex-col items-center">
                        <span class="text-[8px] font-black text-gray-700 uppercase tracking-[0.5em] mb-4">Danger Zone</span>
                        {{ include('user/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
