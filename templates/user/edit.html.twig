{% extends 'base.html.twig' %}

{% block title %}Editar Jugador - RxUp{% endblock %}

{% block body %}
<div class="min-h-[80vh] flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8">

    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="flex justify-center mb-6">
            <div class="h-16 w-16 bg-amber-500 rounded-2xl -rotate-3 flex items-center justify-center shadow-xl">
                <i class="fas fa-user-edit text-white text-2xl rotate-3"></i>
            </div>
        </div>
        <h2 class="text-center text-3xl font-black text-gray-900 tracking-tight uppercase">
            Editar Perfil
        </h2>
        <p class="mt-2 text-center text-sm text-gray-500 font-medium">
            Actualizando los datos de <span class="text-indigo-600 font-bold">{{ user.name }}</span>
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-10 px-8 shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-gray-100 rounded-3xl">

            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                <div>
                    <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-1 ml-1">Nombre y Apellidos</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-id-card text-gray-300"></i>
                        </div>
                        {{ form_widget(form.name, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 transition-all sm:text-sm'
                            }
                        }) }}
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-1 ml-1">Email</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-envelope text-gray-300"></i>
                        </div>
                        {{ form_widget(form.email, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 transition-all sm:text-sm'
                            }
                        }) }}
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-1 ml-1">Teléfono</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-phone text-gray-300"></i>
                        </div>
                        {{ form_widget(form.phone, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 transition-all sm:text-sm'
                            }
                        }) }}
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full flex justify-center py-4 px-4 border border-transparent rounded-2xl shadow-lg shadow-amber-100 text-sm font-black text-white bg-amber-500 hover:bg-amber-600 transition-all uppercase tracking-widest">
                        Guardar Cambios
                    </button>
                </div>

            {{ form_end(form) }}

            <div class="mt-8 pt-6 border-t border-gray-50 flex flex-col gap-4">
                <a href="{{ path('app_user_index') }}" class="text-center text-xs font-bold text-gray-400 hover:text-gray-600 uppercase tracking-widest transition-colors">
                    <i class="fas fa-chevron-left mr-1"></i> Cancelar
                </a>

                {# Botón de borrar con confirmación simple #}
                {{ include('user/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
