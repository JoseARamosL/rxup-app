{% extends 'base.html.twig' %}

{% block title %}Editar Jugador - RxUp{% endblock %}

{% block body %}
    <div class="min-h-screen md:min-h-[85vh] flex flex-col justify-center py-8 md:py-12 px-4 sm:px-6 lg:px-8">

        {# Header con icono en ángulo #}
        <div class="sm:mx-auto sm:w-full sm:max-w-md">
            <div class="flex justify-center mb-6">
                <div class="h-16 w-16 bg-amber-500 rounded-[1.5rem] -rotate-3 flex items-center justify-center shadow-2xl shadow-amber-100 transition-transform hover:rotate-0 duration-300">
                    <i class="fas fa-user-edit text-white text-2xl rotate-3"></i>
                </div>
            </div>
            <h2 class="text-center text-3xl font-black text-gray-900 tracking-tighter uppercase leading-none">
                Editar Perfil
            </h2>
            <p class="mt-3 text-center text-xs md:text-sm text-gray-500 font-medium uppercase tracking-wider">
                Actualizando a <span class="text-indigo-600 font-black">{{ user.name }}</span>
            </p>
        </div>

        <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
            <div class="bg-white py-10 px-6 md:px-10 shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-gray-100 rounded-[2.5rem]">

                {{ form_start(form, {'attr': {'class': 'space-y-7'}}) }}

                {# Campo Nombre #}
                <div class="space-y-2">
                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] ml-1">Nombre y Apellidos</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-id-card text-gray-300 group-focus-within:text-indigo-500 transition-colors"></i>
                        </div>
                        {{ form_widget(form.name, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 transition-all text-sm font-bold shadow-sm'
                            }
                        }) }}
                    </div>
                </div>

                {# Campo Email #}
                <div class="space-y-2">
                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] ml-1">Correo Electrónico</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-envelope text-gray-300 group-focus-within:text-indigo-500 transition-colors"></i>
                        </div>
                        {{ form_widget(form.email, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 transition-all text-sm font-bold shadow-sm'
                            }
                        }) }}
                    </div>
                </div>

                {# Campo Teléfono #}
                <div class="space-y-2">
                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] ml-1">Teléfono de contacto</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-phone text-gray-300 group-focus-within:text-indigo-500 transition-colors"></i>
                        </div>
                        {{ form_widget(form.phone, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 transition-all text-sm font-bold shadow-sm',
                                'placeholder': 'Ej: 600 000 000'
                            }
                        }) }}
                    </div>
                </div>

                {# Botón Guardar Principal #}
                <div class="pt-4">
                    <button type="submit" class="group w-full flex items-center justify-center py-5 px-4 border border-transparent rounded-[1.5rem] shadow-xl shadow-amber-100 text-xs font-black text-white bg-amber-500 hover:bg-amber-600 transition-all uppercase tracking-[0.2em]">
                        <i class="fas fa-save mr-2 group-hover:scale-110 transition-transform"></i>
                        Guardar Cambios
                    </button>
                </div>

                {{ form_end(form) }}

                {# Acciones secundarias separadas #}
                <div class="mt-8 pt-8 border-t border-gray-50 space-y-4">
                    <a href="{{ path('app_user_index') }}" class="flex items-center justify-center w-full py-2 text-[10px] font-black text-gray-300 hover:text-indigo-600 uppercase tracking-[0.2em] transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i> Volver al listado
                    </a>

                    {# Botón de borrar estilizado desde el include #}
                    <div class="flex justify-center">
                        {{ include('user/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
