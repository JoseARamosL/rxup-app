{% extends 'admin/base_admin.html.twig' %}

{% block title %}Importar jugadores — RXUP Admin{% endblock %}
{% block page_title_mobile %}Importar Excel{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">

        {# Volver #}
        <div class="mb-6">
            <a href="{{ path('app_user_index') }}"
               class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-2">
                <i class="fa-solid fa-chevron-left text-xs"></i>
                Volver a jugadores
            </a>
            <h1 class="text-xl font-semibold text-gray-900">Importar jugadores desde Excel</h1>
            <p class="text-sm text-gray-500 mt-0.5">Se usará la hoja "INFO JUGADORES". Se comprueba por teléfono para evitar duplicados.</p>
        </div>

        {# Formulario de subida #}
        <div class="rounded-xl border border-gray-200 bg-white p-6 mb-6"
             x-data="{ loading: false, filename: '' }">
            <form method="post" enctype="multipart/form-data" class="space-y-4"
                  @submit="loading = true">
                <input type="hidden" name="_token" value="{{ csrf_token('import_users') }}">

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Archivo Excel</label>
                    <input type="file"
                           name="excel_file"
                           accept=".xlsx,.xls,.ods"
                           required
                           @change="filename = $event.target.files[0]?.name ?? ''"
                           class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer transition-colors">
                    <p class="mt-1.5 text-xs text-gray-400" x-text="filename ? 'Archivo seleccionado: ' + filename : 'Formatos aceptados: .xlsx, .xls, .ods'"></p>
                </div>

                <div class="rounded-lg bg-blue-50 border border-blue-200 px-4 py-3">
                    <p class="text-xs font-medium text-blue-700 mb-1">Columnas esperadas (en orden):</p>
                    <div class="flex flex-wrap gap-1.5 mt-1">
                        {% for col in ['NOMBRE/APELLIDOS', 'LIGA', 'INSTAGRAM', 'TELEFONO', 'FECHA NACIMIENTO'] %}
                            <span class="rounded px-2 py-0.5 text-xs font-mono {{ col == 'NOMBRE/APELLIDOS' or col == 'TELEFONO' ? 'bg-blue-700 text-white' : 'bg-blue-100 text-blue-600' }}">
                                {{ col }}
                            </span>
                        {% endfor %}
                        <span class="rounded px-2 py-0.5 text-xs font-mono bg-blue-100 text-blue-600">...</span>
                    </div>
                    <p class="mt-2 text-xs text-blue-600">En negrito las columnas que se importan. La primera fila se considera cabecera y se ignora.</p>
                </div>

                <div class="flex items-center justify-end pt-2 border-t border-gray-100">
                    <button type="submit"
                            :disabled="loading"
                            class="inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
                        <template x-if="!loading">
                            <i class="fa-solid fa-file-import text-xs"></i>
                        </template>
                        <template x-if="loading">
                            <svg class="h-3.5 w-3.5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                            </svg>
                        </template>
                        <span x-text="loading ? 'Procesando...' : 'Importar'"></span>
                    </button>
                </div>

                {# Estado de carga #}
                <div x-show="loading" x-cloak class="rounded-lg bg-blue-50 border border-blue-200 px-4 py-3 flex items-center gap-3">
                    <svg class="h-4 w-4 animate-spin text-blue-600 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                    </svg>
                    <p class="text-sm text-blue-700">Leyendo el archivo e importando jugadores, espera un momento...</p>
                </div>
            </form>
        </div>

        {# Resultados #}
        {% if results is not null %}
            <div class="space-y-4">

                {# Resumen #}
                <div class="grid grid-cols-3 gap-3">
                    <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-center">
                        <p class="text-2xl font-semibold text-emerald-700">{{ results.created|length }}</p>
                        <p class="text-xs text-emerald-600 mt-0.5">Creados</p>
                    </div>
                    <div class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-center">
                        <p class="text-2xl font-semibold text-gray-600">{{ results.skipped|length }}</p>
                        <p class="text-xs text-gray-500 mt-0.5">Ya existían</p>
                    </div>
                    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-center">
                        <p class="text-2xl font-semibold text-red-600">{{ results.errors|length }}</p>
                        <p class="text-xs text-red-500 mt-0.5">Errores</p>
                    </div>
                </div>

                {# Detalle creados #}
                {% if results.created|length > 0 %}
                    <div class="rounded-xl border border-emerald-200 bg-white overflow-hidden">
                        <div class="flex items-center gap-2 px-4 py-3 bg-emerald-50 border-b border-emerald-200">
                            <i class="fa-solid fa-circle-check text-emerald-600 text-xs"></i>
                            <span class="text-sm font-medium text-emerald-700">Jugadores creados</span>
                        </div>
                        <ul class="divide-y divide-gray-100">
                            {% for item in results.created %}
                                <li class="px-4 py-2.5 text-sm text-gray-700">{{ item }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {# Detalle omitidos #}
                {% if results.skipped|length > 0 %}
                    <div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
                        <div class="flex items-center gap-2 px-4 py-3 bg-gray-50 border-b border-gray-200">
                            <i class="fa-solid fa-circle-minus text-gray-400 text-xs"></i>
                            <span class="text-sm font-medium text-gray-600">Ya existían (omitidos)</span>
                        </div>
                        <ul class="divide-y divide-gray-100 max-h-48 overflow-y-auto">
                            {% for item in results.skipped %}
                                <li class="px-4 py-2.5 text-sm text-gray-400">{{ item }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {# Detalle errores #}
                {% if results.errors|length > 0 %}
                    <div class="rounded-xl border border-red-200 bg-white overflow-hidden">
                        <div class="flex items-center gap-2 px-4 py-3 bg-red-50 border-b border-red-200">
                            <i class="fa-solid fa-circle-exclamation text-red-500 text-xs"></i>
                            <span class="text-sm font-medium text-red-600">Filas con errores</span>
                        </div>
                        <ul class="divide-y divide-gray-100">
                            {% for item in results.errors %}
                                <li class="px-4 py-2.5 text-sm text-red-500">{{ item }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {% if results.created|length > 0 %}
                    <div class="text-right">
                        <a href="{{ path('app_user_index') }}"
                           class="inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors">
                            Ver lista de jugadores
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </a>
                    </div>
                {% endif %}

            </div>
        {% endif %}

    </div>
{% endblock %}
