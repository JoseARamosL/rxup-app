{% extends 'base.html.twig' %}

{% block title %}Nuevo Jugador - RxUp{% endblock %}

{% block body %}
    <div class="min-h-screen md:min-h-[85vh] flex flex-col justify-center py-8 md:py-12 px-4 sm:px-6 lg:px-8">

        {# Header con Icono #}
        <div class="sm:mx-auto sm:w-full sm:max-w-md">
            <div class="flex justify-center mb-6">
                <div class="h-16 w-16 bg-indigo-600 rounded-[1.5rem] rotate-3 flex items-center justify-center shadow-2xl shadow-indigo-200 transition-transform hover:rotate-0 duration-300">
                    <i class="fas fa-user-plus text-white text-2xl -rotate-3"></i>
                </div>
            </div>
            <h2 class="text-center text-3xl font-black text-gray-900 tracking-tighter uppercase leading-none">
                Alta de Jugador
            </h2>
            <p class="mt-3 text-center text-xs md:text-sm text-gray-500 font-medium uppercase tracking-wider">
                Registra un nuevo miembro en <span class="text-indigo-600 font-black">RxUp Padel</span>
            </p>
        </div>

        <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
            <div class="bg-white py-10 px-6 md:px-10 shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-gray-100 rounded-[2.5rem]">

                {{ form_start(form, {'attr': {'class': 'space-y-7'}}) }}

                {# Campo Nombre #}
                <div class="space-y-2">
                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] ml-1">Nombre y Apellidos</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-user text-gray-300 group-focus-within:text-indigo-500 transition-colors"></i>
                        </div>
                        {{ form_widget(form.name, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 placeholder:text-gray-400 focus:ring-2 focus:ring-indigo-600 transition-all text-sm font-bold shadow-sm',
                                'placeholder': 'Nombre completo'
                            }
                        }) }}
                    </div>
                </div>

                {# Campo Email #}
                <div class="space-y-2">
                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] ml-1">Correo Electrónico</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-envelope text-gray-300 group-focus-within:text-indigo-500 transition-colors"></i>
                        </div>
                        {{ form_widget(form.email, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 placeholder:text-gray-400 focus:ring-2 focus:ring-indigo-600 transition-all text-sm font-bold shadow-sm',
                                'placeholder': 'ejemplo@correo.com'
                            }
                        }) }}
                    </div>
                </div>

                {# Campo Teléfono #}
                <div class="space-y-2">
                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] ml-1">Teléfono</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-phone text-gray-300 group-focus-within:text-indigo-500 transition-colors"></i>
                        </div>
                        {{ form_widget(form.phone, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 placeholder:text-gray-400 focus:ring-2 focus:ring-indigo-600 transition-all text-sm font-bold shadow-sm',
                                'placeholder': '600 00 00 00'
                            }
                        }) }}
                    </div>
                </div>

                {# Aviso de Contraseña Estilizado #}
                <div class="rounded-2xl bg-indigo-50/50 border border-indigo-100 p-4 relative overflow-hidden">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 bg-white h-8 w-8 rounded-lg flex items-center justify-center shadow-sm">
                            <i class="fas fa-key text-indigo-500 text-xs"></i>
                        </div>
                        <div class="ml-4">
                            <p class="text-[9px] font-black text-indigo-400 uppercase tracking-widest mb-0.5">Seguridad</p>
                            <p class="text-[11px] font-bold text-indigo-700 uppercase tracking-tight">
                                Clave inicial: <span class="bg-indigo-600 text-white px-2 py-0.5 rounded ml-1 font-mono">nopassword</span>
                            </p>
                        </div>
                    </div>
                </div>

                {# Botón de Acción #}
                <div class="pt-2">
                    <button type="submit" class="group w-full flex items-center justify-center py-5 px-4 border border-transparent rounded-[1.5rem] shadow-xl shadow-indigo-100 text-xs font-black text-white bg-indigo-600 hover:bg-indigo-700 transition-all uppercase tracking-[0.2em]">
                        <i class="fas fa-check-circle mr-2 group-hover:scale-110 transition-transform"></i>
                        Crear Cuenta Oficial
                    </button>
                </div>

                {{ form_end(form) }}

                <div class="mt-8">
                    <a href="{{ path('app_user_index') }}" class="flex justify-center text-[10px] font-black text-gray-300 hover:text-indigo-600 uppercase tracking-[0.2em] transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i> Volver al listado
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
