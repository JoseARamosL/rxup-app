{% extends 'base.html.twig' %}

{% block title %}Nuevo Jugador - RxUp{% endblock %}

{% block body %}
<div class="min-h-[80vh] flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8">

    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="flex justify-center mb-6">
            <div class="h-16 w-16 bg-indigo-600 rounded-2xl rotate-3 flex items-center justify-center shadow-xl">
                <i class="fas fa-user-plus text-white text-2xl -rotate-3"></i>
            </div>
        </div>
        <h2 class="text-center text-3xl font-black text-gray-900 tracking-tight uppercase">
            Nuevo Jugador
        </h2>
        <p class="mt-2 text-center text-sm text-gray-500 font-medium">
            Registra los datos básicos del deportista
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-10 px-8 shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-gray-100 rounded-3xl">

            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                <div>
                    <label for="name" class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-1 ml-1">Nombre y Apellidos</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-user text-gray-300"></i>
                        </div>
                        {{ form_widget(form.name, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 transition-all',
                                'placeholder': 'Nombre del jugador'
                            }
                        }) }}
                    </div>
                </div>

                <div>
                    <label for="email" class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-1 ml-1">Email</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-envelope text-gray-300"></i>
                        </div>
                        {{ form_widget(form.email, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 transition-all',
                                'placeholder': 'correo@ejemplo.com'
                            }
                        }) }}
                    </div>
                </div>

                <div>
                    <label for="phone" class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-1 ml-1">Teléfono</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-phone text-gray-300"></i>
                        </div>
                        {{ form_widget(form.phone, {
                            'attr': {
                                'class': 'block w-full pl-11 pr-4 py-4 bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 transition-all',
                                'placeholder': '600 000 000'
                            }
                        }) }}
                    </div>
                </div>

                <div class="rounded-2xl bg-indigo-50 p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-key text-indigo-400"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-[11px] font-bold text-indigo-700 uppercase tracking-tight">
                                Contraseña inicial: <span class="bg-indigo-200 px-1 rounded">nopassword</span>
                            </p>
                        </div>
                    </div>
                </div>

                <div>
                    <button type="submit" class="w-full flex justify-center py-4 px-4 border border-transparent rounded-2xl shadow-lg shadow-indigo-200 text-sm font-black text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all uppercase tracking-widest">
                        Crear Cuenta
                    </button>
                </div>

            {{ form_end(form) }}

            <div class="mt-6">
                <a href="{{ path('app_user_index') }}" class="flex justify-center text-xs font-bold text-gray-400 hover:text-gray-600 uppercase tracking-widest">
                    Cancelar y volver
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
