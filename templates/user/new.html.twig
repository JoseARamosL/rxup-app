{% extends 'base.html.twig' %}

{% block title %}Nuevo Jugador - RXUP{% endblock %}

{% block body %}
    <div class="min-h-screen md:min-h-[85vh] flex flex-col justify-center py-8 md:py-12 px-4 sm:px-6 lg:px-8 relative">

        {# Header Estilo RXUP #}
        <div class="sm:mx-auto sm:w-full sm:max-w-md relative z-10">
            <div class="flex justify-center mb-8">
                <div class="h-20 w-20 bg-[#e63946] rounded-[2rem] rotate-3 flex items-center justify-center shadow-[0_15px_35px_rgba(230,57,70,0.3)] transition-transform hover:rotate-0 duration-500 group">
                    <i class="fas fa-user-plus text-white text-2xl -rotate-3 group-hover:scale-110 transition-transform"></i>
                </div>
            </div>
            <h2 class="text-center text-4xl font-black text-[#e2d9c2] tracking-tighter uppercase italic leading-none">
                Alta de <span class="text-[#e63946]">Jugador</span>
            </h2>
            <p class="mt-4 text-center text-[10px] font-black text-gray-500 uppercase tracking-[0.4em]">
                Registra un nuevo miembro en <span class="text-[#e2d9c2]">RXUP ARENA</span>
            </p>
        </div>

        <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-md relative z-10">
            <div class="bg-[#1a1a1a] py-10 px-6 md:px-12 shadow-[0_40px_80px_rgba(0,0,0,0.6)] border border-white/5 rounded-[3rem]">

                {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

                {# Campo Nombre #}
                <div class="space-y-3">
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-2">Nombre y Apellidos</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <i class="fas fa-user text-gray-700 group-focus-within:text-[#e63946] transition-colors"></i>
                        </div>
                        {{ form_widget(form.name, {
                            'attr': {
                                'class': 'block w-full pl-12 pr-5 py-5 bg-[#252525] border-0 rounded-[1.5rem] text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] transition-all text-sm font-bold shadow-inner outline-none placeholder-gray-800',
                                'placeholder': 'NOMBRE COMPLETO'
                            }
                        }) }}
                    </div>
                </div>

                {# Campo Email #}
                <div class="space-y-3">
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-2">Correo Electrónico</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <i class="fas fa-envelope text-gray-700 group-focus-within:text-[#e63946] transition-colors"></i>
                        </div>
                        {{ form_widget(form.email, {
                            'attr': {
                                'class': 'block w-full pl-12 pr-5 py-5 bg-[#252525] border-0 rounded-[1.5rem] text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] transition-all text-sm font-bold shadow-inner outline-none placeholder-gray-800',
                                'placeholder': 'EJEMPLO@CORREO.COM'
                            }
                        }) }}
                    </div>
                </div>

                {# Campo Teléfono #}
                <div class="space-y-3">
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-2">Teléfono</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <i class="fas fa-phone text-gray-700 group-focus-within:text-[#e63946] transition-colors"></i>
                        </div>
                        {{ form_widget(form.phone, {
                            'attr': {
                                'class': 'block w-full pl-12 pr-5 py-5 bg-[#252525] border-0 rounded-[1.5rem] text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] transition-all text-sm font-bold shadow-inner outline-none placeholder-gray-800',
                                'placeholder': '600 00 00 00'
                            }
                        }) }}
                    </div>
                </div>

                {# Aviso de Contraseña RXUP #}
                <div class="rounded-2xl bg-[#0f0f0f] border border-white/5 p-5 relative overflow-hidden shadow-inner">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 bg-[#e63946] h-10 w-10 rounded-xl flex items-center justify-center shadow-lg">
                            <i class="fas fa-key text-white text-xs"></i>
                        </div>
                        <div class="ml-5">
                            <p class="text-[9px] font-black text-[#e63946] uppercase tracking-[0.2em] mb-1">Configuración Inicial</p>
                            <p class="text-[11px] font-bold text-gray-400 uppercase tracking-tight">
                                Password: <span class="bg-[#252525] text-[#e2d9c2] px-2 py-1 rounded ml-1 font-mono border border-white/5">nopassword</span>
                            </p>
                        </div>
                    </div>
                </div>

                {# Botón de Acción #}
                <div class="pt-4">
                    <button type="submit" class="group w-full flex items-center justify-center py-6 px-4 rounded-[2rem] text-[11px] font-black text-white bg-[#e63946] hover:bg-[#ff4d5a] transition-all uppercase tracking-[0.4em] shadow-[0_20px_40px_rgba(230,57,70,0.3)] italic">
                        <i class="fas fa-check-circle mr-3 group-hover:scale-125 transition-transform"></i>
                        Crear Cuenta Oficial
                    </button>
                </div>

                {{ form_end(form) }}

                <div class="mt-10">
                    <a href="{{ path('app_user_index') }}" class="flex justify-center text-[10px] font-black text-gray-600 hover:text-[#e2d9c2] uppercase tracking-[0.3em] transition-all group">
                        <i class="fas fa-arrow-left mr-3 group-hover:-translate-x-2 transition-transform"></i> Volver a la Lista
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
