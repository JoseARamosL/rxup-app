{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nuevo jugador — RXUP Admin{% endblock %}
{% block page_title_mobile %}Nuevo jugador{% endblock %}

{% block body %}
    <div class="max-w-lg mx-auto">

        {# Volver #}
        <div class="mb-6">
            <a href="{{ path('app_user_index') }}"
               class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-2">
                <i class="fa-solid fa-chevron-left text-xs"></i>
                Volver a jugadores
            </a>
            <h1 class="text-xl font-semibold text-gray-900">Nuevo jugador</h1>
            <p class="text-sm text-gray-500 mt-0.5">Registra un nuevo miembro</p>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Nombre completo</label>
                {{ form_widget(form.name, {
                    'attr': {
                        'class': 'block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors',
                        'placeholder': 'Nombre y apellidos'
                    }
                }) }}
                <div class="mt-1 text-xs text-red-600">{{ form_errors(form.name) }}</div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                {{ form_widget(form.email, {
                    'attr': {
                        'class': 'block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors',
                        'placeholder': 'ejemplo@correo.com'
                    }
                }) }}
                <div class="mt-1 text-xs text-red-600">{{ form_errors(form.email) }}</div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Teléfono</label>
                {{ form_widget(form.phone, {
                    'attr': {
                        'class': 'block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors',
                        'placeholder': '600 00 00 00'
                    }
                }) }}
                <div class="mt-1 text-xs text-red-600">{{ form_errors(form.phone) }}</div>
            </div>

            {# Aviso contraseña #}
            <div class="flex items-start gap-3 rounded-lg bg-amber-50 border border-amber-200 px-4 py-3">
                <i class="fa-solid fa-key text-amber-500 text-sm mt-0.5 shrink-0"></i>
                <p class="text-xs text-amber-700">
                    La contraseña inicial será <code class="font-mono bg-amber-100 px-1 rounded">nopassword</code>. El jugador no necesita contraseña para acceder.
                </p>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2 border-t border-gray-100">
                <a href="{{ path('app_user_index') }}"
                   class="rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                    Cancelar
                </a>
                <button type="submit"
                        class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors">
                    Crear jugador
                </button>
            </div>

            {{ form_end(form) }}
        </div>

    </div>
{% endblock %}
