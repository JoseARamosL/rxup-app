{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ user.name }} — RXUP Admin{% endblock %}
{% block page_title_mobile %}{{ user.name }}{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">

        {# Volver #}
        <div class="mb-6">
            <a href="{{ path('app_user_index') }}"
               class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-2">
                <i class="fa-solid fa-chevron-left text-xs"></i>
                Volver a jugadores
            </a>
            <h1 class="text-xl font-semibold text-gray-900">Perfil del jugador</h1>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white overflow-hidden">

            {# Cabecera #}
            <div class="flex items-center gap-4 px-6 py-5 border-b border-gray-100">
                <div class="h-12 w-12 rounded-full bg-gray-200 flex items-center justify-center text-sm font-semibold text-gray-600 shrink-0">
                    {{ user.name|slice(0,2)|upper }}
                </div>
                <div>
                    <h2 class="text-base font-semibold text-gray-900">{{ user.name }}</h2>
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700 ring-1 ring-red-600/20">Admin</span>
                    {% else %}
                        <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Jugador</span>
                    {% endif %}
                </div>
            </div>

            {# Datos #}
            <dl class="divide-y divide-gray-100">
                <div class="flex items-center justify-between px-6 py-4">
                    <dt class="text-sm font-medium text-gray-500">Email</dt>
                    <dd class="text-sm text-gray-900">{{ user.email }}</dd>
                </div>
                <div class="flex items-center justify-between px-6 py-4">
                    <dt class="text-sm font-medium text-gray-500">Teléfono</dt>
                    <dd class="text-sm text-gray-900">{{ user.phone ?? '—' }}</dd>
                </div>
                <div class="flex items-center justify-between px-6 py-4">
                    <dt class="text-sm font-medium text-gray-500">ID</dt>
                    <dd class="text-xs font-mono text-gray-400">#{{ user.id }}</dd>
                </div>
            </dl>

            {# Acciones #}
            <div class="flex items-center gap-3 px-6 py-4 border-t border-gray-100">
                <a href="{{ path('app_user_edit', {'id': user.id}) }}"
                   class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors">
                    Editar
                </a>
                {{ include('user/_delete_form.html.twig') }}
            </div>

        </div>
    </div>
{% endblock %}
