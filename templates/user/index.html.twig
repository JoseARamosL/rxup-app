{% extends 'admin/base_admin.html.twig' %}

{% block title %}Jugadores — RXUP Admin{% endblock %}
{% block page_title_mobile %}Jugadores{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto"
         x-data="{
             search: '',
             filterUser(name, email, phone) {
                 let s = this.search.toLowerCase();
                 let sClean = s.replace(/[\s\-\.]/g, '');
                 let pClean = (phone || '').replace(/[\s\-\.]/g, '');
                 return name.toLowerCase().includes(s) ||
                        email.toLowerCase().includes(s) ||
                        (pClean !== '' && sClean !== '' && pClean.includes(sClean));
             }
         }">

        {# Header #}
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-xl font-semibold text-gray-900">Jugadores</h1>
                <p class="text-sm text-gray-500 mt-0.5">Gestiona todos los miembros</p>
            </div>
            <div class="flex items-center gap-2">
                <a href="{{ path('app_user_import') }}"
                   class="inline-flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                    <i class="fa-solid fa-file-import text-xs"></i>
                    Importar Excel
                </a>
                <a href="{{ path('app_user_new') }}"
                   class="inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors">
                    <i class="fa-solid fa-user-plus text-xs"></i>
                    Nuevo jugador
                </a>
            </div>
        </div>

        {# Buscador #}
        <div class="relative mb-5">
            <div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
                <i class="fa-solid fa-search text-sm text-gray-400"></i>
            </div>
            <input type="text"
                   x-model="search"
                   placeholder="Buscar por nombre, email o teléfono..."
                   class="block w-full rounded-lg border border-gray-300 bg-white py-2.5 pl-9 pr-4 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors">
        </div>

        {# Tabla #}
        <div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
            <table class="min-w-full divide-y divide-gray-100">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Jugador</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Teléfono</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Rol</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for user in users %}
                        <tr class="hover:bg-gray-50 transition-colors"
                            x-show="filterUser('{{ user.name|e('js') }}', '{{ user.email|e('js') }}', '{{ user.phone|default('')|e('js') }}')">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-semibold text-gray-600 shrink-0">
                                        {{ user.name|slice(0,2)|upper }}
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">{{ user.name }}</p>
                                        <p class="text-xs text-gray-400">{{ user.email }}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">
                                {{ user.phone ?? '—' }}
                            </td>
                            <td class="px-6 py-4">
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-red-600/20">
                                        Admin
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">
                                        Jugador
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="{{ path('app_user_show', {'id': user.id}) }}"
                                       class="rounded-md border border-gray-200 p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-50 transition-colors">
                                        <i class="fa-solid fa-eye text-xs"></i>
                                    </a>
                                    <a href="{{ path('app_user_edit', {'id': user.id}) }}"
                                       class="rounded-md border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                                        Editar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {# Sin resultados en búsqueda #}
            <div class="px-6 py-10 text-center" x-show="search !== ''" x-cloak>
                <i class="fa-solid fa-user-slash text-2xl text-gray-300 mb-2 block"></i>
                <p class="text-sm text-gray-400">Sin coincidencias para "<span x-text="search"></span>"</p>
            </div>
        </div>

    </div>
{% endblock %}
