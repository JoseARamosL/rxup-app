<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Padel App{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <script src="https://cdn.tailwindcss.com"></script>
        {# Añadimos FontAwesome para los iconos #}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-gray-50 text-gray-900">
        <nav class="bg-white border-b border-gray-100 px-4 py-4">
            <div class="max-w-7xl mx-auto flex justify-between items-center">
                <a href="{{ path('app_home') }}" class="font-black text-xl tracking-tighter text-indigo-600">RXUP PADEL</a>

                <div class="space-x-6 flex items-center">
                    {% if app.user %}
                        {# Enlace para Admin: Crear Jugador #}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_user_new') }}" class="text-xs font-bold bg-emerald-500 text-white px-3 py-2 rounded-lg hover:bg-emerald-600 transition-colors">
                                <i class="fas fa-plus mr-1"></i> JUGADOR
                            </a>
                            <a href="{{ path('app_user_index') }}" class="text-sm font-bold text-gray-600 hover:text-indigo-600">Usuarios</a>
                            <a href="{{ path('app_admin_tournament_index') }}" class="text-sm font-bold text-red-500 border-r border-gray-200 pr-4">Panel Admin</a>
                        {% endif %}

                        <a href="{{ path('app_tournament_index') }}" class="text-sm font-bold text-gray-600 hover:text-indigo-600">Torneos</a>
                        <a href="{{ path('app_my_games') }}" class="text-sm font-bold text-indigo-600 bg-indigo-50 px-4 py-2 rounded-xl">🎾 Mis Partidos</a>

                        <div class="flex flex-col items-end leading-tight">
                            <span class="text-[10px] uppercase font-bold text-gray-400 tracking-wider">{{ app.user.name }}</span>
                            <a href="{{ path('app_logout') }}" class="text-[10px] text-gray-400 hover:text-red-500 font-medium">SALIR</a>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-sm font-bold text-indigo-600">Entrar</a>
                    {% endif %}
                </div>
            </div>
        </nav>

        <main>
        {# Mensajes Flash unificados estilo Tailwind #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="max-w-7xl mx-auto mt-4 px-4">
                    <div class="{% if label == 'success' %}bg-green-100 border-green-500 text-green-700{% else %}bg-blue-100 border-blue-500 text-blue-700{% endif %} border-l-4 p-4 rounded shadow-sm flex items-center">
                        <i class="fas fa-check-circle mr-2"></i>
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

            {% block body %}{% endblock %}
            {% block javascripts %}{% endblock %}
        </main>
    </body>
</html>
