<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Padel App{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <script src="https://cdn.tailwindcss.com"></script>
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-gray-50 text-gray-900">
        <nav class="bg-white border-b border-gray-100 px-4 py-4">
            <div class="max-w-7xl mx-auto flex justify-between items-center">
                <a href="{{ path('app_home') }}" class="font-black text-xl tracking-tighter text-indigo-600">RXUP PADEL</a>

                <div class="space-x-6 flex items-center">
                    {% if app.user %}
                        <a href="{{ path('app_tournament_index') }}" class="text-sm font-bold text-gray-600 hover:text-indigo-600">Torneos</a>
                        <a href="{{ path('app_my_games') }}" class="text-sm font-bold text-indigo-600 bg-indigo-50 px-4 py-2 rounded-xl">🎾 Mis Partidos</a>

                        {# Si es Admin, mostramos enlace al panel #}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_admin_tournament_index') }}" class="text-sm font-bold text-red-500">Panel Admin</a>
                        {% endif %}

                        <span class="text-xs text-gray-400">{{ app.user.name }}</span>
                        <a href="{{ path('app_logout') }}" class="text-xs text-gray-400 hover:text-red-500">Salir</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-sm font-bold text-indigo-600">Entrar</a>
                    {% endif %}
                </div>
            </div>
        </nav>

        <main>
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="max-w-7xl mx-auto mt-4 px-4">
                    <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded shadow-sm">
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
            {% block body %}{% endblock %}
            {% block javascripts %}{% endblock %}
        </main>
    </body>
</html>

