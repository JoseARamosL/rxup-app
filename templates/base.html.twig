<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Padel App{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    {% block stylesheets %}{% endblock %}
    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 font-sans" x-data="{ mobileMenu: false }">

<nav class="bg-white border-b border-gray-100 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">

            {# Logo #}
            <div class="flex items-center">
                <a href="{{ path('app_home') }}" class="font-black text-xl tracking-tighter text-indigo-600 flex items-center">
                    <span class="bg-indigo-600 text-white px-2 py-1 rounded-lg mr-2 text-sm italic">RX</span> UP PADEL
                </a>
            </div>

            {# Enlaces Escritorio (Hidden on Mobile) #}
            <div class="hidden md:flex items-center space-x-6">
                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="flex items-center space-x-4 border-r border-gray-100 pr-6 mr-2">
                            <a href="{{ path('app_user_index') }}" class="text-xs font-black text-gray-400 hover:text-indigo-600 uppercase tracking-widest">Usuarios</a>
                            <a href="{{ path('app_admin_tournament_index') }}" class="text-xs font-black text-red-500 hover:text-red-600 uppercase tracking-widest">Panel Admin</a>
                        </div>
                    {% endif %}

                    <a href="{{ path('app_tournament_index') }}" class="text-xs font-black text-gray-500 hover:text-indigo-600 uppercase tracking-widest">Torneos</a>
                    <a href="{{ path('app_my_games') }}" class="text-xs font-black text-indigo-600 bg-indigo-50 px-4 py-2 rounded-xl hover:bg-indigo-100 transition-all">🎾 Mis Partidos</a>

                    <div class="flex items-center ml-4 pl-4 border-l border-gray-100">
                        <div class="flex flex-col items-end leading-none">
                            <span class="text-[10px] uppercase font-black text-gray-900 tracking-tighter">{{ app.user.name }}</span>
                            <a href="{{ path('app_logout') }}" class="text-[9px] text-gray-400 hover:text-red-500 font-bold uppercase tracking-widest">Salir</a>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="text-xs font-black text-indigo-600 uppercase tracking-widest border-2 border-indigo-600 px-5 py-2 rounded-xl hover:bg-indigo-600 hover:text-white transition-all">Entrar</a>
                {% endif %}
            </div>

            {# Botón Hamburguesa (Only Mobile) #}
            <div class="flex items-center md:hidden">
                <button @click="mobileMenu = !mobileMenu" class="text-gray-500 hover:text-indigo-600 focus:outline-none p-2">
                    <i class="fa-solid" :class="mobileMenu ? 'fa-xmark text-xl' : 'fa-bars-staggered text-xl'"></i>
                </button>
            </div>
        </div>
    </div>

    {# Menú Móvil Desplegable #}
    <div x-show="mobileMenu"
         x-cloak
         x-collapse
         @click.away="mobileMenu = false"
         class="md:hidden bg-white border-t border-gray-50 pb-6 px-4 shadow-xl">

        <div class="flex flex-col space-y-2 pt-4">
            {% if app.user %}
                {# Sección Perfil Móvil #}
                <div class="bg-gray-50 p-4 rounded-2xl mb-4 flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Conectado como</p>
                        <p class="font-black text-gray-900">{{ app.user.name }}</p>
                    </div>
                    <a href="{{ path('app_logout') }}" class="h-10 w-10 bg-white border border-red-100 text-red-500 rounded-xl flex items-center justify-center">
                        <i class="fa-solid fa-power-off"></i>
                    </a>
                </div>

                <a href="{{ path('app_my_games') }}" class="flex items-center p-4 bg-indigo-600 text-white rounded-2xl font-black uppercase text-xs tracking-widest shadow-lg shadow-indigo-200">
                    <i class="fa-solid fa-racquet text-lg mr-3"></i> Mis Partidos
                </a>

                <a href="{{ path('app_tournament_index') }}" class="flex items-center p-4 text-gray-700 font-black uppercase text-xs tracking-widest">
                    <i class="fa-solid fa-trophy w-8"></i> Torneos
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                    <div class="mt-4 pt-4 border-t border-gray-100">
                        <p class="text-[9px] font-black text-gray-400 uppercase tracking-[0.3em] mb-3 ml-4">Administración</p>
                        <a href="{{ path('app_admin_tournament_index') }}" class="flex items-center p-4 text-red-500 font-black uppercase text-xs tracking-widest bg-red-50 rounded-2xl mb-2">
                            <i class="fa-solid fa-lock w-8"></i> Panel Admin
                        </a>
                        <a href="{{ path('app_user_index') }}" class="flex items-center p-4 text-gray-700 font-black uppercase text-xs tracking-widest">
                            <i class="fa-solid fa-users w-8"></i> Gestionar Usuarios
                        </a>
                        <a href="{{ path('app_user_new') }}" class="flex items-center p-4 text-emerald-600 font-black uppercase text-xs tracking-widest">
                            <i class="fa-solid fa-plus w-8"></i> Nuevo Jugador
                        </a>
                    </div>
                {% endif %}

            {% else %}
                <a href="{{ path('app_login') }}" class="flex items-center justify-center p-4 bg-indigo-600 text-white rounded-2xl font-black uppercase text-xs tracking-widest">
                    Entrar a la App
                </a>
            {% endif %}
        </div>
    </div>
</nav>

<main class="pb-12">
    {# Mensajes Flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="max-w-7xl mx-auto mt-4 px-4 sm:px-6 lg:px-8">
                <div class="{% if label == 'success' %}bg-emerald-50 text-emerald-700 border-emerald-200{% else %}bg-indigo-50 text-indigo-700 border-indigo-200{% endif %} border rounded-2xl p-4 flex items-center shadow-sm">
                    <i class="fas fa-check-circle mr-3"></i>
                    <p class="text-xs font-black uppercase tracking-tight">{{ message }}</p>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

{% block javascripts %}
    <script src="https://unpkg.com/@alpinejs/collapse@3.x.x/dist/cdn.min.js" defer></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
{% endblock %}
</body>
</html>
