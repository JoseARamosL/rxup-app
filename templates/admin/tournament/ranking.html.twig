{% extends 'base.html.twig' %}

{% block title %}Clasificación - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto py-10 px-4">
    <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">🏆 Clasificación de Liga</h1>
            <p class="text-gray-500 text-sm">Torneo: {{ tournament.name }}</p>
        </div>
        <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}" class="bg-white border border-gray-300 px-4 py-2 rounded-xl text-sm font-bold text-gray-700 hover:bg-gray-50 transition shadow-sm">
            Volver al Calendario
        </a>
    </div>

    <div class="bg-white shadow-2xl rounded-3xl overflow-hidden border border-gray-100">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50 text-xs font-bold text-gray-400 uppercase tracking-widest">
                    <tr>
                        <th class="px-6 py-4 text-left text-gray-600">Pos / Pareja</th>
                        <th class="px-4 py-4">Pts</th>
                        <th class="px-4 py-4">PJ</th>
                        <th class="px-4 py-4 text-green-600">PG</th>
                        <th class="px-4 py-4 text-yellow-600">PE</th>
                        <th class="px-4 py-4 text-red-600">PP</th>
                        <th class="px-4 py-4">PF (Juegos)</th>
                        <th class="px-4 py-4">PC</th>
                        <th class="px-4 py-4 bg-gray-100 text-gray-700">DF</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 text-center font-medium text-gray-700">
                    {% for team, data in stats %}
                        <tr class="{{ loop.first ? 'bg-indigo-50/30' : 'hover:bg-gray-50/50' }} transition">
                            <td class="px-6 py-4 text-left">
                                <span class="inline-block w-6 text-gray-400 italic text-sm">{{ loop.index }}º</span>
                                <span class="font-bold text-gray-900 ml-2">{{ team }}</span>
                            </td>
                            <td class="px-4 py-4">
                                <span class="inline-block bg-indigo-600 text-white px-3 py-1 rounded-lg text-sm font-black shadow-sm">
                                    {{ data.points }}
                                </span>
                            </td>
                            <td class="px-4 py-4">{{ data.pj }}</td>
                            <td class="px-4 py-4">{{ data.pg }}</td>
                            <td class="px-4 py-4">{{ data.pe }}</td>
                            <td class="px-4 py-4">{{ data.pp }}</td>
                            <td class="px-4 py-4 text-gray-500">{{ data.pf }}</td>
                            <td class="px-4 py-4 text-gray-500">{{ data.pc }}</td>
                            <td class="px-4 py-4 font-black {{ data.df > 0 ? 'text-green-600' : (data.df < 0 ? 'text-red-500' : 'text-gray-400') }}">
                                {{ data.df > 0 ? '+' : '' }}{{ data.df }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
