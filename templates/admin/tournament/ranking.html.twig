{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ranking {{ tournament.name }} — RXUP Admin{% endblock %}
{% block page_title_mobile %}Ranking{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto">

        {# Cabecera #}
        <div class="flex items-center justify-between mb-6">
            <div>
                <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}"
                   class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-2">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                    Volver a partidos
                </a>
                <h1 class="text-xl font-semibold text-gray-900">Clasificación</h1>
                <p class="text-sm text-gray-500 mt-0.5">{{ tournament.name }}</p>
            </div>
        </div>

        {# Tabla #}
        <div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
            <table class="min-w-full divide-y divide-gray-100">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Pareja</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Pts</th>
                        <th class="hidden md:table-cell px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">PJ</th>
                        <th class="hidden md:table-cell px-4 py-3 text-center text-xs font-semibold text-emerald-600 uppercase tracking-wider">PG</th>
                        <th class="hidden md:table-cell px-4 py-3 text-center text-xs font-semibold text-amber-600 uppercase tracking-wider">PE</th>
                        <th class="hidden md:table-cell px-4 py-3 text-center text-xs font-semibold text-red-500 uppercase tracking-wider">PP</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Juegos</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">DF</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for team, data in stats %}
                        <tr class="hover:bg-gray-50 transition-colors {{ loop.index <= 3 ? 'bg-amber-50/50' : '' }}">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <span class="text-sm font-semibold w-6 text-center {{ loop.index == 1 ? 'text-amber-500' : (loop.index == 2 ? 'text-gray-400' : (loop.index == 3 ? 'text-orange-400' : 'text-gray-400')) }}">
                                        {{ loop.index }}
                                    </span>
                                    <div class="min-w-0">
                                        {% set players = team|split('/') %}
                                        <p class="text-sm font-medium text-gray-900 truncate">{{ players[0]|trim }}</p>
                                        <p class="text-xs text-gray-400 truncate">{{ players[1]|default('')|trim }}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-4 text-center">
                                <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-gray-900 text-xs font-semibold text-white">
                                    {{ data.points }}
                                </span>
                            </td>
                            <td class="hidden md:table-cell px-4 py-4 text-center text-sm text-gray-500">{{ data.pj }}</td>
                            <td class="hidden md:table-cell px-4 py-4 text-center text-sm font-medium text-emerald-600">{{ data.pg }}</td>
                            <td class="hidden md:table-cell px-4 py-4 text-center text-sm font-medium text-amber-600">{{ data.pe }}</td>
                            <td class="hidden md:table-cell px-4 py-4 text-center text-sm font-medium text-red-500">{{ data.pp }}</td>
                            <td class="px-4 py-4 text-center text-sm text-gray-500">
                                <span class="text-gray-900 font-medium">{{ data.pf }}</span>
                                <span class="text-gray-300 mx-1">/</span>
                                <span>{{ data.pc }}</span>
                            </td>
                            <td class="px-6 py-4 text-center text-sm font-semibold {{ data.df > 0 ? 'text-emerald-600' : (data.df < 0 ? 'text-red-500' : 'text-gray-400') }}">
                                {{ data.df > 0 ? '+' : '' }}{{ data.df }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Leyenda #}
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-gray-400">
            <span>Pts: Puntos</span>
            <span>PJ: Jugados</span>
            <span class="text-emerald-600">PG: Ganados</span>
            <span class="text-amber-600">PE: Empatados</span>
            <span class="text-red-500">PP: Perdidos</span>
            <span>DF: Diferencia de juegos</span>
        </div>

    </div>
{% endblock %}
