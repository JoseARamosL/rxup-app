{% extends 'admin/base_admin.html.twig' %}

{% block title %}Parejas — {{ tournament.name }} — RXUP Admin{% endblock %}
{% block page_title_mobile %}Parejas{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.min.css" rel="stylesheet">
    <style>
        .ts-wrapper.single .ts-control { border-radius: 0.5rem; border: 1px solid #d1d5db; padding: 0.5rem 0.75rem; font-size: 0.875rem; box-shadow: none; }
        .ts-wrapper.single.focus .ts-control { border-color: #111827; box-shadow: 0 0 0 1px #111827; }
        .ts-dropdown { border: 1px solid #e5e7eb; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); font-size: 0.875rem; }
        .ts-dropdown .option { padding: 0.5rem 0.75rem; }
        .ts-dropdown .option:hover, .ts-dropdown .option.active { background: #f3f4f6; color: #111827; }
    </style>
{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto">

        {# Cabecera #}
        <div class="mb-6">
            <a href="{{ path('app_admin_tournament_index') }}"
               class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-2">
                <i class="fa-solid fa-chevron-left text-xs"></i>
                Volver a torneos
            </a>
            <h1 class="text-xl font-semibold text-gray-900">Parejas inscritas</h1>
            <p class="text-sm text-gray-500 mt-0.5">{{ tournament.name }}</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            {# Lista de parejas #}
            <div class="lg:col-span-2">
                <div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
                    {% if teams is empty %}
                        <div class="flex flex-col items-center justify-center py-14 text-center">
                            <i class="fa-solid fa-users text-3xl text-gray-300 mb-3"></i>
                            <p class="text-sm font-medium text-gray-500">No hay parejas inscritas</p>
                            <p class="text-xs text-gray-400 mt-1">Inscribe la primera pareja desde el formulario</p>
                        </div>
                    {% else %}
                        <ul class="divide-y divide-gray-100">
                            {% for team in teams %}
                                <li class="flex items-center gap-4 px-5 py-4">
                                    <div class="flex -space-x-2 shrink-0">
                                        <div class="h-8 w-8 rounded-full bg-blue-500 border-2 border-white flex items-center justify-center text-white text-xs font-semibold">
                                            {{ team.player1.name|slice(0,1)|upper }}
                                        </div>
                                        <div class="h-8 w-8 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center text-white text-xs font-semibold">
                                            {{ team.player2.name|slice(0,1)|upper }}
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">{{ team.player1.name }}</p>
                                        <p class="text-sm text-gray-500">{{ team.player2.name }}</p>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>

            {# Formulario inscripción #}
            <div class="rounded-xl border border-gray-200 bg-white p-5 h-fit">
                <h2 class="text-sm font-semibold text-gray-900 mb-4">Inscribir pareja</h2>
                {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
                    {{ form_row(form.player1, {
                        'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1.5'}
                    }) }}
                    {{ form_row(form.player2, {
                        'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1.5'}
                    }) }}
                    <button type="submit"
                            class="w-full rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors">
                        Confirmar pareja
                    </button>
                {{ form_end(form) }}
            </div>

        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script>
        document.querySelectorAll('select').forEach(function(el) {
            new TomSelect(el, {
                placeholder: 'Buscar jugador...',
                searchField: ['text'],
                maxOptions: null,
            });
        });
    </script>
{% endblock %}
