{% extends 'base.html.twig' %}

{% block title %}Parejas - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-black text-gray-900 uppercase">Parejas de {{ tournament.name }}</h1>
            <p class="text-gray-500">Inscribe a los jugadores en parejas para este torneo.</p>
        </div>
        <a href="{{ path('app_admin_tournament_index') }}" class="text-sm font-bold text-gray-400 hover:text-indigo-600">
            <i class="fas fa-arrow-left mr-2"></i> VOLVER AL TORNEO
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-4">
            <h2 class="text-xs font-black text-gray-400 uppercase tracking-widest">Parejas Inscritas</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {% for team in teams %}
                    <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center justify-between">
                        <div class="flex items-center space-x-4">
                            <div class="flex -space-x-3">
                                <div class="h-10 w-10 rounded-full bg-indigo-600 border-2 border-white flex items-center justify-center text-white text-[10px] font-bold">
                                    {{ team.player1.name|slice(0,1) }}
                                </div>
                                <div class="h-10 w-10 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center text-white text-[10px] font-bold">
                                    {{ team.player2.name|slice(0,1) }}
                                </div>
                            </div>
                            <div>
                                <p class="text-sm font-black text-gray-900 uppercase">{{ team.player1.name }}</p>
                                <p class="text-sm font-black text-gray-900 uppercase">{{ team.player2.name }}</p>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-gray-400 text-sm italic">No hay parejas inscritas aún.</p>
                {% endfor %}
            </div>
        </div>

        <div class="bg-gray-900 p-8 rounded-3xl text-white h-fit shadow-xl">
            <h2 class="text-xl font-black mb-6 uppercase tracking-tight">Inscribir Pareja</h2>
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                <div>
                    {{ form_row(form.player1, {'attr': {'class': 'w-full bg-gray-800 border-0 rounded-xl p-4 text-white focus:ring-2 focus:ring-indigo-500'}}) }}
                </div>
                <div>
                    {{ form_row(form.player2, {'attr': {'class': 'w-full bg-gray-800 border-0 rounded-xl p-4 text-white focus:ring-2 focus:ring-indigo-500'}}) }}
                </div>
                <button class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-black py-4 rounded-2xl transition-all shadow-lg shadow-indigo-500/20 uppercase tracking-widest text-xs">
                    Confirmar Pareja
                </button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
