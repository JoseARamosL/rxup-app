{% extends 'base.html.twig' %}

{% block title %}Gestión de Torneos - RXUP{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-8 md:py-12 px-4 sm:px-6 lg:px-8">

        {# Header Adaptable RXUP #}
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-12 relative">
            <div class="absolute -left-4 top-0 w-1 h-12 bg-[#e63946] rounded-full hidden md:block"></div>
            <div>
                <span class="text-[#e63946] font-black text-[10px] uppercase tracking-[0.4em] mb-1 block ml-1">Admin Dashboard</span>
                <h1 class="text-4xl md:text-5xl font-black text-[#e2d9c2] tracking-tighter uppercase italic leading-none">Gestión de Torneos</h1>
                <p class="mt-2 text-[10px] text-gray-500 font-bold uppercase tracking-widest italic">Control total de las competiciones oficiales.</p>
            </div>
            <a href="{{ path('app_admin_tournament_new') }}" class="group w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-[#e63946] text-white text-[11px] font-black rounded-2xl shadow-xl shadow-[#e63946]/20 hover:bg-[#ff4d5a] transition-all uppercase tracking-[0.2em] italic">
                <i class="fas fa-plus mr-2 group-hover:rotate-90 transition-transform"></i> Nuevo Torneo
            </a>
        </div>

        {# Contenedor Principal Dark #}
        <div class="bg-[#1a1a1a] shadow-[0_30px_60px_rgba(0,0,0,0.4)] rounded-[2.5rem] overflow-hidden border border-white/5 relative">

            {# Vista Escritorio: Tabla #}
            <div class="hidden md:block">
                <table class="min-w-full divide-y divide-white/5">
                    <thead class="bg-white/[0.02]">
                    <tr>
                        <th class="px-8 py-6 text-left text-[9px] font-black text-gray-500 uppercase tracking-[0.3em]">Nombre Competición</th>
                        <th class="px-6 py-6 text-left text-[9px] font-black text-gray-500 uppercase tracking-[0.3em]">Formato</th>
                        <th class="px-6 py-6 text-left text-[9px] font-black text-gray-500 uppercase tracking-[0.3em]">Estado</th>
                        <th class="px-8 py-6 text-right text-[9px] font-black text-gray-500 uppercase tracking-[0.3em]">Operaciones</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                    {% for tournament in tournaments %}
                        <tr class="hover:bg-white/[0.02] transition-colors group">
                            <td class="px-8 py-6">
                                <span class="text-sm font-black text-[#e2d9c2] uppercase tracking-tight italic group-hover:text-white transition-colors">{{ tournament.name }}</span>
                            </td>
                            <td class="px-6 py-6">
                                <span class="px-3 py-1.5 text-[9px] font-black uppercase tracking-widest rounded-lg border {{ tournament.type == 'LEAGUE' ? 'bg-blue-500/10 text-blue-400 border-blue-500/20' : 'bg-purple-500/10 text-purple-400 border-purple-500/20' }}">
                                    {{ tournament.type == 'LEAGUE' ? 'Liga' : 'Torneo' }}
                                </span>
                            </td>
                            <td class="px-6 py-6">
                                {% if tournament.active %}
                                    <span class="inline-flex items-center text-[9px] font-black uppercase tracking-widest text-emerald-500 bg-emerald-500/10 px-3 py-1.5 rounded-lg border border-emerald-500/20">
                                        <span class="h-1.5 w-1.5 bg-emerald-500 rounded-full mr-2 animate-pulse"></span> ONLINE
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center text-[9px] font-black uppercase tracking-widest text-[#e63946] bg-[#e63946]/10 px-3 py-1.5 rounded-lg border border-[#e63946]/20">
                                        <span class="h-1.5 w-1.5 bg-[#e63946] rounded-full mr-2"></span> OFF
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-8 py-6 text-right space-x-3">
                                <a href="{{ path('app_admin_game_index', {'id': tournament.id}) }}" class="inline-flex items-center px-5 py-2.5 bg-white/5 text-[#e2d9c2] text-[10px] font-black rounded-xl hover:bg-[#e63946] hover:text-white transition-all uppercase tracking-widest border border-white/10 shadow-lg">
                                    GESTIONAR
                                </a>
                                <a href="{{ path('app_admin_tournament_edit', {'id': tournament.id}) }}" class="inline-flex items-center px-4 py-2.5 bg-white/5 text-gray-500 text-[10px] font-black rounded-xl hover:text-white hover:bg-white/10 transition-all uppercase tracking-widest">
                                    EDITAR
                                </a>
                                <form method="post" action="{{ path('app_admin_tournament_delete', {'id': tournament.id}) }}" onsubmit="return confirm('¿Confirmar borrado? Esta acción es irreversible.');" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tournament.id) }}">
                                    <button class="p-2.5 text-gray-700 hover:text-[#e63946] transition-colors">
                                        <i class="fas fa-trash-alt text-sm"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Vista Móvil: Cards RXUP #}
            <div class="md:hidden divide-y divide-white/5">
                {% for tournament in tournaments %}
                    <div class="p-8 space-y-6">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-[9px] font-black text-gray-600 uppercase tracking-[0.3em] mb-1">Competición</p>
                                <h3 class="text-xl font-black text-[#e2d9c2] uppercase tracking-tighter italic">{{ tournament.name }}</h3>
                            </div>
                            <span class="px-3 py-1.5 text-[9px] font-black uppercase tracking-widest rounded-lg border {{ tournament.type == 'LEAGUE' ? 'bg-blue-500/10 text-blue-400 border-blue-500/20' : 'bg-purple-500/10 text-purple-400 border-purple-500/20' }}">
                                {{ tournament.type == 'LEAGUE' ? 'Liga' : 'Torneo' }}
                            </span>
                        </div>

                        <div class="flex justify-between items-center bg-white/[0.02] p-5 rounded-3xl border border-white/5">
                            <div class="flex flex-col">
                                <span class="text-[9px] font-black text-gray-600 uppercase tracking-widest mb-1">Status</span>
                                <span class="text-xs font-black uppercase {{ tournament.active ? 'text-emerald-500' : 'text-[#e63946]' }}">
                                    {{ tournament.active ? '✓ ONLINE' : '✗ OFF' }}
                                </span>
                            </div>
                            <div class="flex gap-3">
                                <a href="{{ path('app_admin_tournament_edit', {'id': tournament.id}) }}" class="w-12 h-12 flex items-center justify-center bg-[#252525] text-gray-500 rounded-2xl border border-white/5 active:scale-95 transition-transform">
                                    <i class="fas fa-edit text-sm"></i>
                                </a>
                                <form method="post" action="{{ path('app_admin_tournament_delete', {'id': tournament.id}) }}" onsubmit="return confirm('¿Borrar?');" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tournament.id) }}">
                                    <button class="w-12 h-12 flex items-center justify-center bg-[#252525] text-[#e63946] rounded-2xl border border-[#e63946]/10 active:scale-95 transition-transform">
                                        <i class="fas fa-trash-alt text-sm"></i>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <a href="{{ path('app_admin_game_index', {'id': tournament.id}) }}" class="w-full inline-flex items-center justify-center px-6 py-5 bg-[#e63946] text-white text-[11px] font-black rounded-2xl shadow-xl shadow-[#e63946]/10 uppercase tracking-[0.2em] italic">
                            GESTIONAR CALENDARIO <i class="fas fa-calendar-alt ml-2"></i>
                        </a>
                    </div>
                {% else %}
                    <div class="p-20 text-center">
                        <i class="fas fa-folder-open text-4xl text-gray-800 mb-4 block"></i>
                        <p class="text-gray-600 uppercase text-[10px] font-black tracking-widest">Base de datos vacía</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
