{% extends 'base.html.twig' %}

{% block title %}Gestión de Torneos{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Gestión de Torneos</h1>
            <p class="mt-2 text-sm text-gray-600">Administra tus ligas y torneos eliminatorios de pádel.</p>
        </div>
        <a href="{{ path('app_admin_tournament_new') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150">
            <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nuevo Torneo
        </a>
    </div>

    <div class="bg-white shadow overflow-hidden sm:rounded-lg border border-gray-200">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nombre</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipo</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                    <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for tournament in tournaments %}
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                            {{ tournament.name }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full {{ tournament.type == 'LEAGUE' ? 'bg-blue-100 text-blue-800' : 'bg-purple-100 text-purple-800' }}">
                                {{ tournament.type == 'LEAGUE' ? 'Liga' : 'Torneo' }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {% if tournament.active %}
                                <span class="text-green-600 flex items-center">
                                    <span class="h-2 w-2 bg-green-600 rounded-full mr-2"></span> Activo
                                </span>
                            {% else %}
                                <span class="text-red-600 flex items-center">
                                    <span class="h-2 w-2 bg-red-600 rounded-full mr-2"></span> Inactivo
                                </span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <a href="{{ path('app_admin_game_index', {'id': tournament.id}) }}" class="text-indigo-600 hover:text-indigo-900 mr-3 font-bold">
                                Gestionar Partidos
                            </a>
                            <a href="#" class="text-gray-400 hover:text-gray-600">Editar</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-6 py-10 text-center text-sm text-gray-500 italic">
                            No hay torneos creados todavía. ¡Crea el primero!
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
