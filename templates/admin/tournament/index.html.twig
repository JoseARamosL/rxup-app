{% extends 'admin/base_admin.html.twig' %}

{% block title %}Torneos — RXUP Admin{% endblock %}
{% block page_title_mobile %}Torneos{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto"
         x-data="{ tab: 'active' }">

        {# Header #}
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-xl font-semibold text-gray-900">Torneos</h1>
                <p class="text-sm text-gray-500 mt-0.5">Gestiona todas las competiciones</p>
            </div>
            <a href="{{ path('app_admin_tournament_new') }}"
               class="inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors">
                <i class="fa-solid fa-plus text-xs"></i>
                Nuevo torneo
            </a>
        </div>

        {# Tabs Activos / Inactivos #}
        <div class="flex items-center gap-1 mb-4 border-b border-gray-200">
            <button @click="tab = 'active'"
                    :class="tab === 'active' ? 'border-b-2 border-gray-900 text-gray-900' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-2.5 text-sm font-medium transition-colors -mb-px">
                Activos
                <span class="ml-1.5 rounded-full px-1.5 py-0.5 text-xs"
                      :class="tab === 'active' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-500'">
                    {{ tournaments|filter(t => t.active)|length }}
                </span>
            </button>
            <button @click="tab = 'inactive'"
                    :class="tab === 'inactive' ? 'border-b-2 border-gray-900 text-gray-900' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-2.5 text-sm font-medium transition-colors -mb-px">
                Inactivos
                <span class="ml-1.5 rounded-full px-1.5 py-0.5 text-xs"
                      :class="tab === 'inactive' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-500'">
                    {{ tournaments|filter(t => not t.active)|length }}
                </span>
            </button>
        </div>

        {# Tabla #}
        <div class="rounded-xl border border-gray-200 bg-white overflow-hidden">

            {# --- ACTIVOS --- #}
            <div x-show="tab === 'active'">
                {% set active = tournaments|filter(t => t.active) %}
                {% if active|length == 0 %}
                    <div class="flex flex-col items-center justify-center py-16 text-center">
                        <i class="fa-solid fa-trophy text-3xl text-gray-300 mb-3"></i>
                        <p class="text-sm font-medium text-gray-500">No hay torneos activos</p>
                    </div>
                {% else %}
                    <table class="min-w-full divide-y divide-gray-100">
                        <thead>
                            <tr class="bg-gray-50">
                                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Nombre</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Formato</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Estado</th>
                                <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for tournament in active %}
                                {{ _self.tournament_row(tournament) }}
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>

            {# --- INACTIVOS --- #}
            <div x-show="tab === 'inactive'" x-cloak>
                {% set inactive = tournaments|filter(t => not t.active) %}
                {% if inactive|length == 0 %}
                    <div class="flex flex-col items-center justify-center py-16 text-center">
                        <i class="fa-solid fa-archive text-3xl text-gray-300 mb-3"></i>
                        <p class="text-sm font-medium text-gray-500">No hay torneos inactivos</p>
                    </div>
                {% else %}
                    <table class="min-w-full divide-y divide-gray-100">
                        <thead>
                            <tr class="bg-gray-50">
                                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Nombre</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Formato</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Estado</th>
                                <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for tournament in inactive %}
                                {{ _self.tournament_row(tournament) }}
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>

        </div>
    </div>

    {# Macro fila de torneo #}
    {% macro tournament_row(tournament) %}
        <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4">
                <span class="text-sm font-medium {{ tournament.active ? 'text-gray-900' : 'text-gray-400' }}">{{ tournament.name }}</span>
            </td>
            <td class="px-6 py-4">
                <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium
                             {{ tournament.type == 'LEAGUE' ? 'bg-blue-50 text-blue-700 ring-1 ring-blue-600/20' : 'bg-purple-50 text-purple-700 ring-1 ring-purple-600/20' }}">
                    {{ tournament.type == 'LEAGUE' ? 'Liga' : 'Torneo' }}
                </span>
            </td>
            <td class="px-6 py-4">
                <form method="post" action="{{ path('app_admin_tournament_toggle_active', {'id': tournament.id}) }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ tournament.id) }}">
                    <button type="submit"
                            class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium border transition-colors
                                   {{ tournament.active
                                       ? 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100'
                                       : 'bg-gray-100 text-gray-400 border-gray-200 hover:bg-gray-200' }}"
                            title="{{ tournament.active ? 'Marcar como inactivo' : 'Marcar como activo' }}">
                        <span class="h-1.5 w-1.5 rounded-full {{ tournament.active ? 'bg-emerald-500' : 'bg-gray-400' }}"></span>
                        {{ tournament.active ? 'Activo' : 'Inactivo' }}
                    </button>
                </form>
            </td>
            <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                    <a href="{{ path('app_admin_game_index', {'id': tournament.id}) }}"
                       class="rounded-md bg-gray-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-gray-700 transition-colors">
                        Gestionar
                    </a>
                    <a href="{{ path('app_admin_tournament_teams', {'id': tournament.id}) }}"
                       class="rounded-md border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                        Parejas
                    </a>
                    <a href="{{ path('app_admin_tournament_edit', {'id': tournament.id}) }}"
                       class="rounded-md border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                        Editar
                    </a>
                    <form method="post" action="{{ path('app_admin_tournament_delete', {'id': tournament.id}) }}"
                          onsubmit="return confirm('¿Eliminar este torneo? Esta acción no se puede deshacer.');" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tournament.id) }}">
                        <button type="submit"
                                class="rounded-md border border-gray-200 p-1.5 text-gray-400 hover:text-red-600 hover:border-red-200 hover:bg-red-50 transition-colors">
                            <i class="fa-solid fa-trash-alt text-xs"></i>
                        </button>
                    </form>
                </div>
            </td>
        </tr>
    {% endmacro %}
{% endblock %}
