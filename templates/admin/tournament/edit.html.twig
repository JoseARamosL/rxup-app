{% extends 'base.html.twig' %}

{% block title %}Editar Torneo: {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto py-10 px-4">
    <div class="mb-6">
        <a href="{{ path('app_admin_tournament_index') }}" class="text-sm text-indigo-600 hover:underline flex items-center">
            ← Volver al listado
        </a>
    </div>

    <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-gray-100">
        <div class="bg-gray-800 px-8 py-6 text-white">
            <h1 class="text-2xl font-bold">Editar Configuración</h1>
            <p class="text-gray-400 text-sm">Estás modificando: {{ tournament.name }}</p>
        </div>

        {{ form_start(form, {'attr': {'class': 'p-8 space-y-6'}}) }}

            <div>
                {{ form_label(form.name) }}
                {{ form_widget(form.name, {'attr': {'class': 'block w-full mt-1 rounded-xl border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500'}}) }}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.type) }}
                    {{ form_widget(form.type, {'attr': {'class': 'block w-full mt-1 rounded-xl border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500'}}) }}
                </div>
                <div class="flex items-center pt-6">
                    {{ form_widget(form.hasRanking) }}
                    {{ form_label(form.hasRanking, null, {'label_attr': {'class': 'ml-2 text-sm font-bold text-gray-700'}}) }}
                </div>
            </div>

            <div>
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'block w-full mt-1 rounded-xl border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500', 'rows': '5'}}) }}
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full bg-indigo-600 text-white py-4 rounded-xl font-bold hover:bg-indigo-700 shadow-lg transition-all uppercase tracking-widest">
                    Guardar Cambios
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
