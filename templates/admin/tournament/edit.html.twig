{% extends 'base.html.twig' %}

{% block title %}Config - {{ tournament.name }} - RXUP{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto py-8 px-4 sm:py-12">

        {# Botón Volver Estilo RXUP #}
        <div class="mb-10">
            <a href="{{ path('app_admin_tournament_index') }}" class="group inline-flex items-center text-[10px] font-black text-gray-500 hover:text-[#e63946] transition-colors uppercase tracking-[0.3em]">
                <i class="fas fa-chevron-left mr-2 transform group-hover:-translate-x-2 transition-transform"></i>
                Panel de Control
            </a>
        </div>

        <div class="bg-[#1a1a1a] shadow-[0_30px_60px_rgba(0,0,0,0.5)] rounded-[3rem] overflow-hidden border border-white/5 relative">

            {# Cabecera de Configuración #}
            <div class="bg-[#e63946] px-8 py-12 text-center sm:text-left relative overflow-hidden">
                {# Rayo decorativo de fondo #}
                <i class="fas fa-bolt absolute right-[-10%] top-[-10%] text-white/10 text-9xl -rotate-12"></i>

                <span class="text-white/60 text-[10px] font-black uppercase tracking-[0.4em] mb-2 block">Settings Arena</span>
                <h1 class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tighter italic italic">Editar Torneo</h1>
                <p class="text-white/80 text-[11px] font-bold mt-2 uppercase tracking-widest">{{ tournament.name }}</p>
            </div>

            {# Formulario con Estética Dark #}
            {{ form_start(form, {'attr': {'class': 'p-8 sm:p-12 space-y-10'}}) }}

            {# Nombre del Torneo #}
            <div class="space-y-3">
                <label class="text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-2">Nombre de la Competición</label>
                {{ form_widget(form.name, {
                    'attr': {'class': 'block w-full bg-[#252525] border-0 rounded-2xl text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] p-5 text-sm font-bold shadow-inner transition-all outline-none placeholder-gray-700'}
                }) }}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
                {# Tipo de Torneo #}
                <div class="space-y-3">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-2">Formato de Juego</label>
                    <div class="relative">
                        {{ form_widget(form.type, {
                            'attr': {'class': 'block w-full bg-[#252525] border-0 rounded-2xl text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] p-5 text-sm font-black shadow-inner appearance-none outline-none'}
                        }) }}
                        <div class="absolute inset-y-0 right-5 flex items-center pointer-events-none text-[#e63946]">
                            <i class="fas fa-caret-down"></i>
                        </div>
                    </div>
                </div>

                {# Toggle de Ranking RXUP #}
                <div class="flex items-center justify-between p-6 bg-[#252525] rounded-3xl border border-white/5 shadow-inner">
                    <div class="flex flex-col">
                        <span class="text-[10px] font-black text-[#e63946] uppercase tracking-[0.2em] mb-1">Ranking</span>
                        <span class="text-[9px] font-bold text-gray-500 uppercase">Clasificación Live</span>
                    </div>

                    <label class="relative inline-flex items-center cursor-pointer">
                        {{ form_widget(form.hasRanking, { 'attr': {'class': 'sr-only peer'} }) }}
                        <div class="w-14 h-7 bg-[#0f0f0f] rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full after:content-[''] after:absolute after:top-[4px] after:start-[4px] after:bg-gray-600 after:rounded-full after:h-5 after:w-6 after:transition-all peer-checked:bg-[#e63946] peer-checked:after:bg-white shadow-inner"></div>
                    </label>
                </div>
            </div>

            {# Descripción / Normativa #}
            <div class="space-y-3">
                <label class="text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-2">Normativa y Reglas</label>
                {{ form_widget(form.description, {
                    'attr': {
                        'class': 'block w-full bg-[#252525] border-0 rounded-[2rem] text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] p-8 text-sm leading-relaxed shadow-inner transition-all outline-none placeholder-gray-700 font-medium',
                        'rows': '6',
                        'placeholder': 'Define aquí el espíritu de la competición...'
                    }
                }) }}
            </div>

            {# Botón Guardar #}
            <div class="pt-8">
                <button type="submit" class="group w-full flex justify-center items-center py-6 px-4 rounded-[2rem] text-xs font-black text-white bg-[#e63946] hover:bg-[#ff4d5a] transition-all uppercase tracking-[0.4em] shadow-[0_15px_40px_rgba(230,57,70,0.3)] italic">
                    <i class="fas fa-save mr-3 group-hover:scale-125 transition-transform"></i> Actualizar Arena
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
