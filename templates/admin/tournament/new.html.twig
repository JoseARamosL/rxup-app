{% extends 'base.html.twig' %}

{% block title %}Nuevo Torneo - Gestión{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto py-8 px-4 sm:py-12">

        <div class="mb-8">
            <a href="{{ path('app_admin_tournament_index') }}" class="group inline-flex items-center text-xs font-black text-gray-400 hover:text-indigo-600 transition-colors uppercase tracking-widest">
                <i class="fas fa-chevron-left mr-2 transform group-hover:-translate-x-1 transition-transform"></i>
                Volver al listado
            </a>
        </div>

        <div class="bg-white shadow-[0_20px_50px_rgba(0,0,0,0.05)] rounded-[2.5rem] overflow-hidden border border-gray-100">

            <div class="bg-indigo-600 px-8 py-10 text-center sm:text-left relative overflow-hidden">
                <div class="absolute -right-10 -top-10 h-40 w-40 bg-white opacity-5 rounded-full"></div>
                <span class="text-indigo-200 text-[10px] font-black uppercase tracking-[0.3em] mb-2 block">Creación de evento</span>
                <h1 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tighter">Nueva Competición</h1>
                <p class="text-indigo-100 text-xs font-medium mt-1 opacity-80 uppercase tracking-wider">Configura los detalles básicos de tu liga o torneo</p>
            </div>

            {{ form_start(form, {'attr': {'class': 'p-6 sm:p-10 space-y-8'}}) }}

            <div class="space-y-2">
                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Nombre de la Competición</label>
                {{ form_widget(form.name, {
                    'attr': {
                        'class': 'block w-full bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-4 text-sm font-bold shadow-sm transition-all',
                        'placeholder': 'Ej: I Open RXUP Verano'
                    }
                }) }}
                <div class="text-red-500 text-[10px] font-bold mt-1 px-1 italic">
                    {{ form_errors(form.name) }}
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                {# Tipo de Formato #}
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Formato de Juego</label>
                    {{ form_widget(form.type, {
                        'attr': {'class': 'block w-full bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-4 text-sm font-bold shadow-sm transition-all'}
                    }) }}
                </div>

                {# INTERRUPTOR PARA CLASIFICACIÓN (En lugar del checkbox) #}
                <div class="flex items-center justify-between p-4 bg-indigo-50/50 rounded-2xl border border-indigo-100/50">
                    <div class="flex flex-col">
                        <span class="text-[10px] font-black text-indigo-600 uppercase tracking-widest">Ranking</span>
                        <span class="text-[11px] font-bold text-gray-500 uppercase">¿Activar clasificación?</span>
                    </div>

                    {# Toggle Switch Personalizado #}
                    <label class="relative inline-flex items-center cursor-pointer">
                        {{ form_widget(form.hasRanking, { 'attr': {'class': 'sr-only peer'} }) }}
                        <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                    </label>
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Normativa y Detalles</label>
                {{ form_widget(form.description, {
                    'attr': {
                        'class': 'block w-full bg-gray-50 border-0 rounded-3xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-6 text-sm leading-relaxed shadow-sm transition-all',
                        'rows': '5',
                        'placeholder': 'Indica aquí las reglas, formato de puntuación, premios...'
                    }
                }) }}
                <p class="mt-2 text-[10px] text-gray-400 font-bold uppercase tracking-tight ml-1 italic opacity-70">
                    <i class="fas fa-info-circle mr-1"></i> Esta información será visible para los jugadores.
                </p>
            </div>

            <div class="pt-6">
                <button type="submit" class="group w-full flex items-center justify-center py-5 px-4 border border-transparent rounded-[1.5rem] shadow-xl shadow-indigo-100 text-xs font-black text-white bg-indigo-600 hover:bg-indigo-700 transition-all uppercase tracking-[0.2em]">
                    <i class="fas fa-check-circle mr-2 group-hover:scale-110 transition-transform"></i>
                    Lanzar Competición
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
