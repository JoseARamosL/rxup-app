{% extends 'admin/base_admin.html.twig' %}

{% block title %}Cruce de partidos — {{ tournament.name }}{% endblock %}
{% block page_title_mobile %}Cruce de partidos{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">

    {# Cabecera #}
    <div class="mb-6">
        <a href="{{ path('app_admin_availability_index', {id: tournament.id}) }}"
           class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-1">
            <i class="fa-solid fa-chevron-left text-xs"></i>
            Volver a disponibilidades
        </a>
        <h1 class="text-xl font-semibold text-gray-900">Cruce de partidos</h1>
        <p class="text-sm text-gray-500 mt-0.5">{{ tournament.name }} — parejas que coinciden en al menos un hueco y aún no han jugado</p>
    </div>

    {# Aviso parejas sin cruce #}
    {% if strandedTeams is not empty %}
        <div class="rounded-xl border border-amber-200 bg-amber-50 px-5 py-4 mb-5">
            <div class="flex items-start gap-3">
                <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5 shrink-0"></i>
                <div>
                    <p class="text-sm font-semibold text-amber-800">
                        {{ strandedTeams|length }} pareja{{ strandedTeams|length != 1 ? 's' : '' }} sin cruce posible
                    </p>
                    <p class="text-xs text-amber-700 mt-0.5 mb-2">Tienen disponibilidad introducida pero ninguna otra pareja coincide en los mismos huecos.</p>
                    <div class="flex flex-wrap gap-2">
                        {% for team in strandedTeams %}
                            <span class="inline-flex items-center gap-1.5 rounded-lg bg-amber-100 border border-amber-200 px-3 py-1.5 text-xs font-medium text-amber-800">
                                <i class="fa-solid fa-users text-amber-500 text-[10px]"></i>
                                {{ team.player1.name }} / {{ team.player2.name }}
                            </span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if suggestions is empty %}
        <div class="rounded-xl border border-gray-200 bg-white flex flex-col items-center justify-center py-16 text-center">
            <i class="fa-solid fa-calendar-xmark text-3xl text-gray-300 mb-3"></i>
            <p class="text-sm font-medium text-gray-500">No hay cruces posibles</p>
            <p class="text-xs text-gray-400 mt-1">Puede que falten disponibilidades o todos los partidos ya estén creados</p>
            <a href="{{ path('app_admin_availability_index', {id: tournament.id}) }}"
               class="mt-4 inline-flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                Revisar disponibilidades
            </a>
        </div>
    {% else %}
        <div class="space-y-4">
            {% for s in suggestions %}
                <div class="rounded-xl border border-gray-200 bg-white overflow-hidden"
                     x-data="{ open: false, slot: '{{ s.slots[0] }}', phase: '', court: '' }">

                    {# Cabecera sugerencia #}
                    <div class="flex items-center justify-between px-5 py-4">
                        <div class="flex items-center gap-4 min-w-0">
                            {# Pareja 1 #}
                            <div class="text-sm min-w-0">
                                <p class="font-medium text-gray-900 truncate">{{ s.team1.player1.name }} / {{ s.team1.player2.name }}</p>
                            </div>
                            <span class="text-xs font-medium text-gray-400 shrink-0">vs</span>
                            {# Pareja 2 #}
                            <div class="text-sm min-w-0">
                                <p class="font-medium text-gray-900 truncate">{{ s.team2.player1.name }} / {{ s.team2.player2.name }}</p>
                            </div>
                        </div>
                        <button @click="open = !open"
                                class="ml-4 shrink-0 inline-flex items-center gap-1.5 rounded-lg bg-gray-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-gray-700 transition-colors">
                            <i class="fa-solid fa-plus text-xs"></i>
                            Crear partido
                        </button>
                    </div>

                    {# Huecos comunes #}
                    <div class="px-5 pb-3 flex flex-wrap gap-2">
                        {% for slot in s.slots %}
                            <button @click="slot = '{{ slot }}'; open = true"
                                    :class="slot === '{{ slot }}' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
                                    class="rounded-lg px-3 py-1.5 text-xs font-medium transition-colors">
                                {{ slot|date('D d/m') }}
                                {{ slot|split(' ')[1] }}
                            </button>
                        {% endfor %}
                    </div>

                    {# Formulario crear partido #}
                    <div x-show="open" x-collapse x-cloak class="border-t border-gray-100 px-5 py-4">
                        <form method="post"
                              action="{{ path('app_admin_availability_create_game', {id: tournament.id}) }}"
                              class="space-y-4">
                            <input type="hidden" name="team1_id" value="{{ s.team1.id }}">
                            <input type="hidden" name="team2_id" value="{{ s.team2.id }}">
                            <input type="hidden" name="slot" :value="slot">

                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Fecha y hora</label>
                                    <input type="text" :value="slot" readonly
                                           class="block w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Jornada</label>
                                    <input type="text" name="phase" x-model="phase"
                                           placeholder="Ej: Jornada 3"
                                           class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Pista</label>
                                    <input type="text" name="court" x-model="court"
                                           placeholder="Ej: Pista 1"
                                           class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <button type="submit"
                                        class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors">
                                    Guardar partido
                                </button>
                                <button type="button" @click="open = false"
                                        class="rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                                    Cancelar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
