{% extends 'admin/base_admin.html.twig' %}

{% block title %}Resultado — {{ tournament.name }} — RXUP Admin{% endblock %}
{% block page_title_mobile %}Resultado{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">

        {# Volver #}
        <div class="mb-6">
            <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}"
               class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-2">
                <i class="fa-solid fa-chevron-left text-xs"></i>
                Volver a partidos
            </a>
            <h1 class="text-xl font-semibold text-gray-900">Editar partido</h1>
            <p class="text-sm text-gray-500 mt-0.5">{{ tournament.name }} · {{ game.phase }}</p>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

            {# Marcador #}
            <div class="rounded-lg border border-gray-200 bg-gray-50 p-5">
                <div class="flex items-center justify-between gap-4">

                    {# Pareja local #}
                    <div class="flex-1 text-center">
                        <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest mb-2">Local</p>
                        <p class="text-sm font-semibold text-gray-900 leading-tight">{{ game.team1.player1.name }}</p>
                        <p class="text-sm text-gray-500 leading-tight">{{ game.team1.player2.name }}</p>
                    </div>

                    {# Input resultado #}
                    <div class="shrink-0 text-center">
                        {{ form_widget(form.score, {
                            'attr': {
                                'class': 'w-36 text-center rounded-lg border border-gray-300 px-3 py-3 text-lg font-mono font-semibold text-gray-900 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors placeholder-gray-300',
                                'placeholder': '6-4 6-2'
                            }
                        }) }}
                        <p class="mt-1.5 text-xs text-gray-400">Formato: 6-2 6-4</p>
                    </div>

                    {# Pareja visitante #}
                    <div class="flex-1 text-center">
                        <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest mb-2">Visitante</p>
                        <p class="text-sm font-semibold text-gray-900 leading-tight">{{ game.team2.player1.name }}</p>
                        <p class="text-sm text-gray-500 leading-tight">{{ game.team2.player2.name }}</p>
                    </div>

                </div>
            </div>

            {# Detalles #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Pista</label>
                    {{ form_widget(form.court, {
                        'attr': {
                            'class': 'block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors'
                        }
                    }) }}
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Fecha y hora</label>
                    {{ form_widget(form.date, {
                        'attr': {
                            'class': 'block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors'
                        }
                    }) }}
                </div>
            </div>

            {# Campos ocultos #}
            <div class="hidden">
                {{ form_row(form.team1) }}
                {{ form_row(form.team2) }}
                {{ form_row(form.phase) }}
            </div>

            <div class="flex items-center justify-end gap-3 pt-2 border-t border-gray-100">
                <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}"
                   class="rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                    Cancelar
                </a>
                <button type="submit"
                        class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors">
                    Guardar resultado
                </button>
            </div>

            {{ form_end(form) }}
        </div>

    </div>
{% endblock %}
