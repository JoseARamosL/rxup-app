{% extends 'base.html.twig' %}

{% block title %}Resultado: {{ game.player1.name }} vs {{ game.player3.name }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto py-10 px-4">
    <div class="bg-white shadow-2xl rounded-3xl overflow-hidden">
        <div class="bg-gray-800 px-8 py-6 text-white flex justify-between items-center">
            <h1 class="text-xl font-bold">Actualizar Partido</h1>
            <span class="bg-gray-700 px-3 py-1 rounded-full text-xs uppercase">{{ game.phase }}</span>
        </div>

        {{ form_start(form, {'attr': {'class': 'p-8 space-y-8'}}) }}

            {# Sección de Resultados (Nueva) #}
            <div class="bg-indigo-50 p-6 rounded-2xl border-2 border-indigo-100 flex items-center justify-around">
                <div class="text-center">
                    <p class="text-xs font-bold text-indigo-600 uppercase mb-2">Sets Pareja A</p>
                    {{ form_widget(form.scoreTeamA, {'attr': {'class': 'text-3xl font-black w-32 text-center rounded-xl border-indigo-200'}}) }}
                </div>
                <div class="text-2xl font-black text-gray-300">VS</div>
                <div class="text-center">
                    <p class="text-xs font-bold text-indigo-600 uppercase mb-2">Sets Pareja B</p>
                    {{ form_widget(form.scoreTeamB, {'attr': {'class': 'text-3xl font-black w-32 text-center rounded-xl border-indigo-200'}}) }}
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 opacity-60">
                <div class="space-y-2">
                    <p class="text-sm font-bold text-gray-500 italic">Datos del encuentro</p>
                    {{ form_row(form.player1) }}
                    {{ form_row(form.player2) }}
                </div>
                <div class="space-y-2 pt-7">
                    {{ form_row(form.player3) }}
                    {{ form_row(form.player4) }}
                </div>
            </div>

            <div class="flex justify-end pt-6 border-t">
                <button type="submit" class="bg-green-600 text-white px-10 py-4 rounded-xl font-black hover:bg-green-700 shadow-lg transition uppercase">
                    Guardar Resultado
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
