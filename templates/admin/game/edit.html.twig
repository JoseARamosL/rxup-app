{% extends 'base.html.twig' %}

{% block title %}Resultado - {{ tournament.name }}{% endblock %}

{% block body %}
    <div class="min-h-screen md:min-h-[85vh] flex flex-col justify-center py-8 md:py-12 px-4 sm:px-6 lg:px-8">

        {# Header con icono #}
        <div class="sm:mx-auto sm:w-full sm:max-w-2xl">
            <div class="flex justify-center mb-6">
                <div class="h-16 w-16 bg-gray-900 rounded-[1.5rem] flex items-center justify-center shadow-2xl border-b-4 border-indigo-600">
                    <i class="fas fa-pennant text-indigo-500 text-2xl"></i>
                </div>
            </div>
            <h2 class="text-center text-3xl font-black text-gray-900 tracking-tighter uppercase leading-none">
                Finalizar Encuentro
            </h2>
            <p class="mt-3 text-center text-[10px] font-black text-gray-400 uppercase tracking-[0.3em]">
                {{ tournament.name }} • {{ game.phase }}
            </p>
        </div>

        <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-2xl">
            <div class="bg-white py-10 px-6 md:px-10 shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-gray-100 rounded-[3rem]">

                {{ form_start(form, {'attr': {'class': 'space-y-10'}}) }}

                {# PANEL DE MARCADOR ESTILO PISTA #}
                <div class="space-y-6">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-6 bg-gray-50 p-6 md:p-8 rounded-[2rem] border border-gray-100 relative">

                        {# Pareja Local #}
                        <div class="text-center flex-1 order-1">
                            <span class="block text-[9px] font-black text-indigo-500 uppercase tracking-widest mb-3">Local</span>
                            <div class="space-y-0.5">
                                <p class="text-sm md:text-base font-black text-gray-900 uppercase tracking-tight leading-tight">{{ game.team1.player1.name }}</p>
                                <p class="text-sm md:text-base font-black text-gray-900 uppercase tracking-tight leading-tight">{{ game.team1.player2.name }}</p>
                            </div>
                        </div>

                        {# INPUT MARCADOR (CENTRAL) #}
                        <div class="flex flex-col items-center order-2 md:mx-4 w-full md:w-auto">
                            <div class="relative group w-full">
                                <div class="absolute -inset-1 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-1000"></div>
                                {{ form_widget(form.score, {
                                    'attr': {
                                        'class': 'relative block w-full md:w-48 text-center text-4xl md:text-5xl font-mono font-black py-5 md:py-6 rounded-2xl border-0 bg-gray-900 text-indigo-400 focus:ring-4 focus:ring-indigo-500/20 transition-all uppercase placeholder-gray-700 tracking-widest',
                                        'placeholder': '0-0 0-0'
                                    }
                                }) }}
                            </div>
                            <span class="text-[8px] font-black text-gray-400 uppercase mt-4 tracking-[0.2em]">Formato: 6-2 6-4</span>
                        </div>

                        {# Pareja Visitante #}
                        <div class="text-center flex-1 order-3">
                            <span class="block text-[9px] font-black text-indigo-500 uppercase tracking-widest mb-3">Visitante</span>
                            <div class="space-y-0.5">
                                <p class="text-sm md:text-base font-black text-gray-900 uppercase tracking-tight leading-tight">{{ game.team2.player1.name }}</p>
                                <p class="text-sm md:text-base font-black text-gray-900 uppercase tracking-tight leading-tight">{{ game.team2.player2.name }}</p>
                            </div>
                        </div>
                    </div>
                </div>

                {# Detalles Logísticos (Compactos) #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-gray-50/50 p-6 rounded-2xl border border-dashed border-gray-200">
                    <div class="space-y-2">
                        <label class="block text-[9px] font-black text-gray-400 uppercase tracking-widest ml-1">Pista / Ubicación</label>
                        {{ form_widget(form.court, {'attr': {'class': 'w-full bg-white border-0 rounded-xl font-bold text-gray-700 p-3 ring-1 ring-gray-100 focus:ring-2 focus:ring-indigo-500 text-xs uppercase'}}) }}
                    </div>
                    <div class="space-y-2">
                        <label class="block text-[9px] font-black text-gray-400 uppercase tracking-widest ml-1">Fecha Programada</label>
                        {{ form_widget(form.date, {'attr': {'class': 'w-full bg-white border-0 rounded-xl font-bold text-gray-700 p-3 ring-1 ring-gray-100 focus:ring-2 focus:ring-indigo-500 text-xs uppercase'}}) }}
                    </div>
                </div>

                {# Campos ocultos #}
                <div class="hidden">
                    {{ form_row(form.team1) }}
                    {{ form_row(form.team2) }}
                    {{ form_row(form.phase) }}
                </div>

                {# Botón de acción #}
                <div class="pt-2">
                    <button type="submit" class="group w-full flex items-center justify-center py-5 px-4 border border-transparent rounded-[1.5rem] shadow-xl shadow-indigo-100 text-xs font-black text-white bg-indigo-600 hover:bg-indigo-700 transition-all uppercase tracking-[0.2em]">
                        <i class="fas fa-check-double mr-2 group-hover:scale-110 transition-transform"></i>
                        Confirmar Resultado
                    </button>
                </div>

                {{ form_end(form) }}

                <div class="mt-8">
                    <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}" class="flex justify-center text-[10px] font-black text-gray-300 hover:text-indigo-600 uppercase tracking-[0.2em] transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i> Volver al calendario
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
