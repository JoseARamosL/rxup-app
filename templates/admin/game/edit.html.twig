{% extends 'base.html.twig' %}

{% block title %}Resultado - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="min-h-[80vh] flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8">

    <div class="sm:mx-auto sm:w-full sm:max-w-2xl">
        <div class="flex justify-center mb-6">
            <div class="h-16 w-16 bg-indigo-600 rounded-2xl rotate-3 flex items-center justify-center shadow-xl">
                <i class="fas fa-trophy text-white text-2xl -rotate-3"></i>
            </div>
        </div>
        <h2 class="text-center text-3xl font-black text-gray-900 tracking-tight uppercase">
            Anotar Resultado
        </h2>
        <p class="mt-2 text-center text-sm text-gray-500 font-medium">
            Introduce el marcador final del encuentro en <span class="text-indigo-600 font-bold">{{ tournament.name }}</span>
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-2xl">
        <div class="bg-white py-10 px-8 shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-gray-100 rounded-[2.5rem]">

            {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

                {# Visualización de las Parejas Enfrentadas #}
                <div class="flex flex-col md:flex-row items-center justify-between gap-6 bg-gray-50 p-6 rounded-3xl border border-gray-100">
                    <div class="text-center flex-1">
                        <span class="block text-[10px] font-black text-indigo-400 uppercase tracking-widest mb-2">Local</span>
                        <p class="text-lg font-black text-gray-900 uppercase leading-tight">{{ game.team1.player1.name }}</p>
                        <p class="text-lg font-black text-gray-900 uppercase leading-tight">{{ game.team1.player2.name }}</p>
                    </div>

                    <div class="text-2xl font-black text-gray-300 italic">VS</div>

                    <div class="text-center flex-1">
                        <span class="block text-[10px] font-black text-indigo-400 uppercase tracking-widest mb-2">Visitante</span>
                        <p class="text-lg font-black text-gray-900 uppercase leading-tight">{{ game.team2.player1.name }}</p>
                        <p class="text-lg font-black text-gray-900 uppercase leading-tight">{{ game.team2.player2.name }}</p>
                    </div>
                </div>

                {# Input del Marcador #}
                <div class="space-y-4 text-center">
                    <label class="inline-block text-xs font-black text-gray-400 uppercase tracking-[0.3em] mb-2">Marcador Final</label>
                    <div class="max-w-xs mx-auto">
                        {{ form_widget(form.score, {
                            'attr': {
                                'class': 'block w-full text-center text-5xl font-mono font-black py-6 rounded-3xl border-2 border-indigo-100 focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all uppercase placeholder-gray-200 tracking-tighter',
                                'placeholder': '6-0 6-0'
                            }
                        }) }}
                    </div>
                    <p class="text-[10px] text-gray-400 font-medium">Usa formatos como: 6-2 6-4 o 6-3 4-6 7-6</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-gray-50">
                    <div class="md:col-span-1">
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Pista</label>
                        {{ form_widget(form.court, {'attr': {'class': 'w-full bg-gray-50 border-0 rounded-xl text-sm p-3'}}) }}
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Fecha y Hora</label>
                        {{ form_widget(form.date, {'attr': {'class': 'w-full bg-gray-50 border-0 rounded-xl text-sm p-3'}}) }}
                    </div>
                </div>

                {# Ocultamos team1 y team2 para que no estorben pero sigan en el form #}
                <div class="hidden">
                    {{ form_row(form.team1) }}
                    {{ form_row(form.team2) }}
                    {{ form_row(form.phase) }}
                </div>

                <div class="pt-4">
                    <button type="submit" class="w-full flex justify-center py-5 px-4 border border-transparent rounded-2xl shadow-lg shadow-indigo-100 text-xs font-black text-white bg-indigo-600 hover:bg-indigo-700 transition-all uppercase tracking-[0.2em]">
                        Guardar Resultado
                    </button>
                </div>

            {{ form_end(form) }}

            <div class="mt-6">
                <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}" class="flex justify-center text-[10px] font-black text-gray-400 hover:text-gray-600 uppercase tracking-widest transition-colors">
                    <i class="fas fa-chevron-left mr-2"></i> Volver al calendario
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
