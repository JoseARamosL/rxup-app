{% extends 'base.html.twig' %}

{% block title %}Resultado: {{ game.player1.name|default('TBD') }} vs {{ game.player3.name|default('TBD') }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto py-10 px-4">
    <div class="bg-white shadow-2xl rounded-3xl overflow-hidden border border-gray-100">
        <div class="bg-gray-800 px-8 py-6 text-white flex justify-between items-center">
            <div>
                <h1 class="text-xl font-bold">Actualizar Marcador</h1>
                <p class="text-gray-400 text-xs mt-1">{{ tournament.name }} - {{ game.phase }}</p>
            </div>
            <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}" class="text-gray-400 hover:text-white transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </a>
        </div>

        {{ form_start(form, {'attr': {'class': 'p-8 space-y-8'}}) }}

            {# Nueva Sección de Marcador Único #}
            <div class="bg-indigo-50 p-8 rounded-3xl border-2 border-indigo-100">
                <div class="text-center mb-6">
                    <span class="text-xs font-black text-indigo-600 uppercase tracking-[0.2em]">Marcador Final</span>
                </div>

                <div class="flex flex-col items-center">
                    <div class="relative w-full max-w-sm">
                        {{ form_widget(form.score, {
                            'attr': {
                                'class': 'block w-full text-center text-4xl font-mono font-black py-4 rounded-2xl border-2 border-indigo-200 focus:ring-4 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all uppercase placeholder-gray-300',
                                'placeholder': '6-2, 3-6, 6-4'
                            }
                        }) }}
                    </div>
                    <div class="mt-4 flex space-x-4 text-sm text-gray-500 italic">
                        <span>Ejemplo: <b class="text-gray-700">6-0, 6-1</b></span>
                        <span>•</span>
                        <span>Separar sets por comas</span>
                    </div>
                </div>
            </div>

            {# Información de los Jugadores (Lectura/Ajuste rápido) #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
                <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100 space-y-3">
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Pareja Local</p>
                    {{ form_row(form.player1) }}
                    {{ form_row(form.player2) }}
                </div>
                <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100 space-y-3">
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Pareja Visitante</p>
                    {{ form_row(form.player3) }}
                    {{ form_row(form.player4) }}
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 opacity-60">
                {{ form_row(form.phase) }}
                {{ form_row(form.court) }}
                {{ form_row(form.date) }}
            </div>

            <div class="flex justify-end pt-8 border-t border-gray-100">
                <button type="submit" class="w-full md:w-auto bg-green-600 text-white px-12 py-4 rounded-2xl font-black hover:bg-green-700 shadow-xl shadow-green-200 transition-all active:scale-95 uppercase tracking-widest">
                    Guardar Resultado
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
