{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nuevo partido — {{ tournament.name }} — RXUP Admin{% endblock %}
{% block page_title_mobile %}Nuevo partido{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.min.css" rel="stylesheet">
    <style>
        .ts-wrapper.single .ts-control { border-radius: 0.5rem; border: 1px solid #d1d5db; padding: 0.5rem 0.75rem; font-size: 0.875rem; box-shadow: none; }
        .ts-wrapper.single.focus .ts-control { border-color: #111827; box-shadow: 0 0 0 1px #111827; }
        .ts-dropdown { border: 1px solid #e5e7eb; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); font-size: 0.875rem; }
        .ts-dropdown .option { padding: 0.5rem 0.75rem; }
        .ts-dropdown .option:hover, .ts-dropdown .option.active { background: #f3f4f6; color: #111827; }
    </style>
{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">

        {# Volver #}
        <div class="mb-6">
            <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}"
               class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-2">
                <i class="fa-solid fa-chevron-left text-xs"></i>
                Volver a partidos
            </a>
            <h1 class="text-xl font-semibold text-gray-900">Nuevo partido</h1>
            <p class="text-sm text-gray-500 mt-0.5">{{ tournament.name }}</p>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

            {# Parejas #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Pareja local</label>
                    {{ form_widget(form.team1) }}
                    <div class="mt-1 text-xs text-red-600">{{ form_errors(form.team1) }}</div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Pareja visitante</label>
                    {{ form_widget(form.team2) }}
                    <div class="mt-1 text-xs text-red-600">{{ form_errors(form.team2) }}</div>
                </div>
            </div>

            <div class="border-t border-gray-100 pt-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Fase / Jornada</label>
                    {{ form_widget(form.phase, {
                        'attr': {
                            'class': 'block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors',
                            'placeholder': 'Ej: Jornada 1'
                        }
                    }) }}
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Pista</label>
                    {{ form_widget(form.court, {
                        'attr': {
                            'class': 'block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors',
                            'placeholder': 'Ej: Pista Central'
                        }
                    }) }}
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Fecha y hora</label>
                    {{ form_widget(form.date, {
                        'attr': {
                            'class': 'block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors'
                        }
                    }) }}
                </div>
            </div>

            <div class="hidden">{{ form_widget(form.score) }}</div>

            {% if form.vars.errors|length > 0 %}
                <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
                    <div class="flex items-start gap-2">
                        <i class="fa-solid fa-triangle-exclamation mt-0.5 shrink-0"></i>
                        <div>
                            {% for error in form.vars.errors %}
                                {{ error.message }}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="flex items-center justify-end gap-3 pt-2 border-t border-gray-100">
                <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}"
                   class="rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                    Cancelar
                </a>
                <button type="submit"
                        class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors">
                    Crear partido
                </button>
            </div>

            {{ form_end(form) }}
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script>
        document.querySelectorAll('select').forEach(function(el) {
            new TomSelect(el, { placeholder: 'Buscar pareja...', searchField: ['text'], maxOptions: null });
        });
    </script>
{% endblock %}
