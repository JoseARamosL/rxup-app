{% extends 'base.html.twig' %}

{% block title %}Nuevo Partido - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto py-10 px-4">
    <div class="bg-white shadow-2xl rounded-3xl overflow-hidden border border-gray-100">
        <div class="bg-indigo-600 px-8 py-6 text-white flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold">Programar Partido</h1>
                <p class="opacity-80 text-sm">Torneo: {{ tournament.name }}</p>
            </div>
            <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}" class="text-indigo-200 hover:text-white text-sm font-medium">Cancelar</a>
        </div>

        {{ form_start(form, {'attr': {'class': 'p-8 space-y-8'}}) }}

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 relative">
                <div class="hidden md:flex absolute inset-0 items-center justify-center pointer-events-none">
                    <span class="bg-gray-100 text-gray-400 font-black px-4 py-2 rounded-full border-4 border-white shadow-sm z-10">VS</span>
                </div>

                <div class="space-y-4 bg-blue-50/50 p-6 rounded-2xl border border-blue-100">
                    <h3 class="text-blue-700 font-bold uppercase tracking-wider text-xs mb-4">Pareja Local</h3>
                    {{ form_row(form.player1) }}
                    {{ form_row(form.player2) }}
                </div>

                <div class="space-y-4 bg-purple-50/50 p-6 rounded-2xl border border-purple-100">
                    <h3 class="text-purple-700 font-bold uppercase tracking-wider text-xs mb-4">Pareja Visitante</h3>
                    {{ form_row(form.player3) }}
                    {{ form_row(form.player4) }}
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-6 border-t border-gray-100">
                {{ form_row(form.phase) }}
                {{ form_row(form.court) }}
                {{ form_row(form.date) }}
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full bg-indigo-600 text-white py-4 rounded-xl font-bold shadow-lg hover:bg-indigo-700 transition-all uppercase tracking-widest">
                    Confirmar y Publicar Partido
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
