{% extends 'base.html.twig' %}

{% block title %}Nuevo Partido - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="min-h-[80vh] flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8">

    <div class="sm:mx-auto sm:w-full sm:max-w-xl">
        <div class="flex justify-center mb-6">
            <div class="h-16 w-16 bg-indigo-600 rounded-2xl rotate-3 flex items-center justify-center shadow-xl">
                <i class="fas fa-plus text-white text-2xl -rotate-3"></i>
            </div>
        </div>
        <h2 class="text-center text-3xl font-black text-gray-900 tracking-tight uppercase">
            Programar Partido
        </h2>
        <p class="mt-2 text-center text-sm text-gray-500 font-medium">
            Selecciona las parejas y los detalles del encuentro para <span class="text-indigo-600 font-bold">{{ tournament.name }}</span>
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-xl">
        <div class="bg-white py-10 px-8 shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-gray-100 rounded-[2.5rem]">

            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {# Pareja Local #}
                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2 ml-1">Pareja Local</label>
                        {{ form_widget(form.team1, {
                            'attr': {'class': 'block w-full bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-4 text-sm font-bold'}
                        }) }}
                    </div>

                    {# Pareja Visitante #}
                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2 ml-1">Pareja Visitante</label>
                        {{ form_widget(form.team2, {
                            'attr': {'class': 'block w-full bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-4 text-sm font-bold'}
                        }) }}
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {# Fase del Torneo #}
                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2 ml-1">Fase / Grupo</label>
                        {{ form_widget(form.phase, {
                            'attr': {
                                'class': 'block w-full bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-4 text-sm',
                                'placeholder': 'Ej: Fase de Grupos'
                            }
                        }) }}
                    </div>

                    {# Pista #}
                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2 ml-1">Pista</label>
                        {{ form_widget(form.court, {
                            'attr': {
                                'class': 'block w-full bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-4 text-sm',
                                'placeholder': 'Ej: Pista Central'
                            }
                        }) }}
                    </div>
                </div>

                {# Fecha y Hora #}
                <div>
                    <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2 ml-1">Fecha y Hora</label>
                    {{ form_widget(form.date, {
                        'attr': {'class': 'block w-full bg-gray-50 border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-4 text-sm'}
                    }) }}
                </div>

                {# Botón de acción #}
                <div class="pt-4">
                    <button type="submit" class="w-full flex justify-center py-5 px-4 border border-transparent rounded-2xl shadow-lg shadow-indigo-100 text-xs font-black text-white bg-indigo-600 hover:bg-indigo-700 transition-all uppercase tracking-[0.2em]">
                        Crear Partido
                    </button>
                </div>

            {{ form_end(form) }}

            <div class="mt-6">
                <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}" class="flex justify-center text-[10px] font-black text-gray-400 hover:text-gray-600 uppercase tracking-widest transition-colors">
                    <i class="fas fa-chevron-left mr-2"></i> Cancelar y volver
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
