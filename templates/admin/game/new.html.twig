{% extends 'base.html.twig' %}

{% block title %}Nuevo Partido - {{ tournament.name }}{% endblock %}

{% block body %}
    <div class="min-h-screen md:min-h-[85vh] flex flex-col justify-center py-8 md:py-12 px-4 sm:px-6 lg:px-8">

        <div class="sm:mx-auto sm:w-full sm:max-w-2xl">
            <div class="flex justify-center mb-6">
                <div class="h-16 w-16 bg-gray-900 rounded-[1.5rem] flex items-center justify-center shadow-2xl border-b-4 border-indigo-600">
                    <i class="fas fa-calendar-plus text-indigo-500 text-2xl"></i>
                </div>
            </div>
            <h2 class="text-center text-3xl font-black text-gray-900 tracking-tighter uppercase leading-none">
                Programar Encuentro
            </h2>
            <p class="mt-3 text-center text-[10px] font-black text-gray-400 uppercase tracking-[0.3em]">
                {{ tournament.name }} • Nueva Entrada
            </p>
        </div>

        <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-2xl">
            <div class="bg-white py-10 px-6 md:px-10 shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-gray-100 rounded-[3rem]">

                {{ form_start(form, {'attr': {'class': 'space-y-10'}}) }}

                {# SECCIÓN DE PAREJAS #}
                <div class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-gray-50 p-8 rounded-[2rem] border border-gray-100">

                        {# Pareja Local #}
                        <div class="space-y-2">
                            <label class="block text-[9px] font-black text-indigo-500 uppercase tracking-widest ml-1">Pareja Local</label>
                            {{ form_widget(form.team1, {
                                'attr': {'class': 'block w-full bg-white border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-4 text-sm font-black transition-all shadow-sm'}
                            }) }}
                        </div>

                        {# Pareja Visitante #}
                        <div class="space-y-2">
                            <label class="block text-[9px] font-black text-indigo-500 uppercase tracking-widest ml-1">Pareja Visitante</label>
                            {{ form_widget(form.team2, {
                                'attr': {'class': 'block w-full bg-white border-0 rounded-2xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-4 text-sm font-black transition-all shadow-sm'}
                            }) }}
                        </div>
                    </div>
                </div>

                {# DETALLES LOGÍSTICOS #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-gray-50/50 p-6 rounded-2xl border border-dashed border-gray-200">
                    <div class="space-y-2">
                        <label class="text-[9px] font-black text-gray-400 uppercase tracking-widest ml-1">Fase / Jornada</label>
                        {{ form_widget(form.phase, {
                            'attr': {'class': 'block w-full bg-white border-0 rounded-xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-3 text-sm font-bold', 'placeholder': 'Ej: Jornada 1'}
                        }) }}
                    </div>
                    <div class="space-y-2">
                        <label class="text-[9px] font-black text-gray-400 uppercase tracking-widest ml-1">Pista</label>
                        {{ form_widget(form.court, {
                            'attr': {'class': 'block w-full bg-white border-0 rounded-xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-3 text-sm font-bold', 'placeholder': 'Ej: Pista 1'}
                        }) }}
                    </div>
                    <div class="md:col-span-2 space-y-2">
                        <label class="text-[9px] font-black text-gray-400 uppercase tracking-widest ml-1">Fecha y Hora</label>
                        {{ form_widget(form.date, {
                            'attr': {'class': 'block w-full bg-white border-0 rounded-xl text-gray-900 ring-1 ring-inset ring-gray-100 focus:ring-2 focus:ring-indigo-600 p-3 text-sm font-bold'}
                        }) }}
                    </div>
                </div>

                {# El campo score suele estar oculto en "New" o vacío #}
                <div class="hidden">
                    {{ form_widget(form.score) }}
                </div>

                {# Botón de acción #}
                <div class="pt-2">
                    <button type="submit" class="group w-full flex items-center justify-center py-5 px-4 border border-transparent rounded-[1.5rem] shadow-xl shadow-indigo-100 text-xs font-black text-white bg-indigo-600 hover:bg-indigo-700 transition-all uppercase tracking-[0.2em]">
                        <i class="fas fa-plus-circle mr-2 group-hover:scale-110 transition-transform"></i>
                        Crear Partido
                    </button>
                </div>

                {{ form_end(form) }}

                <div class="mt-8">
                    <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}" class="flex justify-center text-[10px] font-black text-gray-300 hover:text-indigo-600 uppercase tracking-[0.2em] transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i> Volver al calendario
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
