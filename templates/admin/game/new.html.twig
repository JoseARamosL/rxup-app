{% extends 'base.html.twig' %}

{% block title %}Nuevo Partido - {{ tournament.name }}{% endblock %}

{% block body %}
    <div class="min-h-screen md:min-h-[85vh] flex flex-col justify-center py-8 md:py-12 px-4 sm:px-6 lg:px-8 relative">

        {# Header Estilo RXUP #}
        <div class="sm:mx-auto sm:w-full sm:max-w-2xl relative z-10">
            <div class="flex justify-center mb-8">
                <div class="h-20 w-20 bg-[#252525] rounded-[2rem] flex items-center justify-center shadow-2xl border-b-4 border-[#e63946] group hover:scale-105 transition-transform duration-500">
                    <i class="fas fa-calendar-plus text-[#e63946] text-3xl"></i>
                </div>
            </div>
            <h2 class="text-center text-4xl md:text-5xl font-black text-[#e2d9c2] tracking-tighter uppercase italic leading-none">
                Programar <span class="text-[#e63946]">Encuentro</span>
            </h2>
            <p class="mt-4 text-center text-[10px] font-black text-gray-500 uppercase tracking-[0.4em]">
                {{ tournament.name }} <span class="mx-2 text-gray-700">•</span> Nueva Entrada
            </p>
        </div>

        <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-2xl relative z-10">
            <div class="bg-[#1a1a1a] py-10 px-6 md:px-12 shadow-[0_40px_80px_rgba(0,0,0,0.6)] border border-white/5 rounded-[3rem]">

                {{ form_start(form, {'attr': {'class': 'space-y-12'}}) }}

                {# SECCIÓN DE PAREJAS (Enfrentamiento) #}
                <div class="space-y-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-[#252525] p-8 md:p-10 rounded-[2.5rem] border border-white/5 shadow-inner relative overflow-hidden">

                        {# Elemento decorativo central #}
                        <div class="hidden md:flex absolute inset-0 items-center justify-center pointer-events-none">
                            <span class="text-white/5 font-black text-6xl italic">VS</span>
                        </div>

                        {# Pareja Local #}
                        <div class="space-y-3 relative z-10">
                            <label class="block text-[10px] font-black text-[#e63946] uppercase tracking-[0.3em] ml-2">Pareja Local</label>
                            {{ form_widget(form.team1, {
                                'attr': {'class': 'block w-full bg-[#1a1a1a] border-0 rounded-2xl text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] p-5 text-sm font-black transition-all shadow-inner outline-none'}
                            }) }}
                        </div>

                        {# Pareja Visitante #}
                        <div class="space-y-3 relative z-10">
                            <label class="block text-[10px] font-black text-[#e63946] uppercase tracking-[0.3em] ml-2">Pareja Visitante</label>
                            {{ form_widget(form.team2, {
                                'attr': {'class': 'block w-full bg-[#1a1a1a] border-0 rounded-2xl text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] p-5 text-sm font-black transition-all shadow-inner outline-none'}
                            }) }}
                        </div>
                    </div>
                </div>

                {# DETALLES LOGÍSTICOS #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-[#252525]/50 p-8 rounded-3xl border border-dashed border-white/10">
                    <div class="space-y-3">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest ml-2">Fase / Jornada</label>
                        {{ form_widget(form.phase, {
                            'attr': {'class': 'block w-full bg-[#1a1a1a] border-0 rounded-xl text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] p-4 text-xs font-black shadow-inner outline-none uppercase placeholder-gray-800', 'placeholder': 'EJ: JORNADA 1'}
                        }) }}
                    </div>
                    <div class="space-y-3">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest ml-2">Pista / Arena</label>
                        {{ form_widget(form.court, {
                            'attr': {'class': 'block w-full bg-[#1a1a1a] border-0 rounded-xl text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] p-4 text-xs font-black shadow-inner outline-none uppercase placeholder-gray-800', 'placeholder': 'EJ: CENTRAL'}
                        }) }}
                    </div>
                    <div class="md:col-span-2 space-y-3">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest ml-2">Fecha y Hora del Evento</label>
                        {{ form_widget(form.date, {
                            'attr': {'class': 'block w-full bg-[#1a1a1a] border-0 rounded-xl text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] p-4 text-xs font-black shadow-inner outline-none'}
                        }) }}
                    </div>
                </div>

                {# Oculto Score #}
                <div class="hidden">
                    {{ form_widget(form.score) }}
                </div>

                {# Botón de Acción #}
                <div class="pt-4">
                    <button type="submit" class="group w-full flex items-center justify-center py-6 px-4 rounded-[2rem] text-xs font-black text-white bg-[#e63946] hover:bg-[#ff4d5a] transition-all uppercase tracking-[0.4em] shadow-[0_20px_40px_rgba(230,57,70,0.3)] italic">
                        <i class="fas fa-plus-circle mr-3 group-hover:rotate-90 transition-transform"></i>
                        Confirmar Partido
                    </button>
                </div>

                {{ form_end(form) }}

                <div class="mt-10">
                    <a href="{{ path('app_admin_game_index', {id: tournament.id}) }}" class="flex justify-center text-[10px] font-black text-gray-600 hover:text-[#e2d9c2] uppercase tracking-[0.3em] transition-all group">
                        <i class="fas fa-arrow-left mr-3 group-hover:-translate-x-2 transition-transform"></i> Volver al Calendario
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
