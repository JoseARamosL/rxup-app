{% extends 'base.html.twig' %}

{% block title %}Calendario - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">{{ tournament.name }}</h1>
        <p class="text-gray-600">Gestión de partidos y resultados.</p>
    </div>

    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-semibold text-gray-800">Partidos Programados</h2>
        <a href="{{ path('app_admin_game_new', {id: tournament.id}) }}"  class="bg-indigo-600 text-white px-4 py-2 rounded-lg font-bold hover:bg-indigo-700 transition">
            + Añadir Partido
        </a>
        {% if tournament.hasRanking %}
            <a href="{{ path('app_admin_tournament_ranking', {id: tournament.id}) }}"
            class="bg-yellow-500 text-white px-4 py-2 rounded-lg font-bold hover:bg-yellow-600 transition shadow-sm">
                🏆 Clasificación
            </a>
        {% endif %}
    </div>

    <div class="space-y-8">
        {% for phase, phaseGames in groupedGames %}
            <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 px-6 py-3 border-b border-gray-200">
                    <h3 class="font-bold text-gray-700 uppercase tracking-wider text-sm">{{ phase }}</h3>
                </div>
                <ul class="divide-y divide-gray-200">
                    {% for game in phaseGames %}
                        <li class="p-6 hover:bg-gray-50 transition border-l-4 {{ game.score is not empty ? 'border-green-500' : 'border-transparent' }}">
                            <div class="flex flex-wrap items-center justify-between gap-4">
                                <div class="flex items-center space-x-8 text-center">
                                    {# Pareja Local #}
                                    <div class="w-40">
                                        <p class="font-bold text-gray-900">{{ game.player1.name|default('TBD') }}</p>
                                        <p class="font-bold text-gray-900">{{ game.player2.name|default('TBD') }}</p>
                                    </div>

                                    {# BLOQUE CENTRAL: VS o MARCADOR #}
                                    <div class="flex flex-col items-center justify-center min-w-[150px]">
                                        {% if game.score %}
                                            <div class="bg-gray-900 text-white px-4 py-2 rounded-lg shadow-md font-mono text-lg tracking-widest border-b-2 border-yellow-500">
                                                {{ game.score }}
                                            </div>
                                            <span class="text-[10px] uppercase font-bold text-green-500 mt-2">✓ Finalizado</span>
                                        {% else %}
                                            <div class="text-indigo-600 font-black text-2xl italic px-4">VS</div>
                                            <span class="text-[10px] uppercase font-bold text-gray-400 mt-1">Pendiente</span>
                                        {% endif %}
                                    </div>

                                    {# Pareja Visitante #}
                                    <div class="w-40">
                                        <p class="font-bold text-gray-900">{{ game.player3.name|default('TBD') }}</p>
                                        <p class="font-bold text-gray-900">{{ game.player4.name|default('TBD') }}</p>
                                    </div>
                                </div>

                                <div class="text-sm text-gray-500 bg-gray-50 p-3 rounded-lg border border-gray-100">
                                    <p><span class="font-semibold text-gray-700">Pista:</span> {{ game.court|default('N/A') }}</p>
                                    <p><span class="font-semibold text-gray-700">Hora:</span> {{ game.date ? game.date|date('H:i d/m') : 'Pendiente' }}</p>
                                </div>

                                <div>
                                    <a href="{{ path('app_admin_game_edit', {id: tournament.id, gameId: game.id}) }}"
                                    class="inline-flex items-center px-4 py-2 border border-indigo-600 shadow-sm text-sm font-bold rounded-md text-indigo-600 bg-white hover:bg-indigo-50 transition">
                                        Anotar Resultado
                                    </a>
                                    {# Botón de Eliminar con confirmación simple #}
                                    <form method="post" action="{{ path('app_admin_game_delete', {id: tournament.id, gameId: game.id}) }}" onsubmit="return confirm('¿Estás seguro de que quieres eliminar este partido?');" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.id) }}">
                                        <button class="inline-flex items-center px-3 py-2 border border-red-200 shadow-sm text-sm font-medium rounded-md text-red-600 bg-white hover:bg-red-50 transition" title="Eliminar partido">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            <div class="text-center py-12 bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
                <p class="text-gray-500 italic">No hay partidos creados para este torneo.</p>
                <a href="{{ path('app_admin_game_new', {id: tournament.id}) }}" class="mt-4 inline-block text-indigo-600 font-bold hover:underline">
                    Haz clic aquí para crear el primer partido
                </a>
            </div>
        {% endfor %}
</div>
</div>
{% endblock %}
