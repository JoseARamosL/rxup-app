{% extends 'base.html.twig' %}

{% block title %}Calendario - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    {# Header #}
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-gray-900 uppercase tracking-tighter">{{ tournament.name }}</h1>
            <p class="text-gray-500 font-medium italic">Gestión de partidos y parejas oficiales</p>
        </div>
        <div class="flex gap-3">
             <a href="{{ path('app_admin_game_new', {id: tournament.id}) }}" class="bg-indigo-600 text-white px-6 py-3 rounded-2xl font-black hover:bg-indigo-700 transition shadow-lg shadow-indigo-200 uppercase text-xs">
                + Nuevo Partido
            </a>
            {% if tournament.hasRanking %}
                <a href="{{ path('app_admin_tournament_ranking', {id: tournament.id}) }}" class="bg-amber-400 text-black px-6 py-3 rounded-2xl font-black hover:bg-amber-500 transition shadow-lg shadow-amber-100 uppercase text-xs">
                    🏆 Clasificación
                </a>
            {% endif %}
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">

        {# IZQUIERDA: CALENDARIO DE PARTIDOS (Con Acordeones Admin) #}
        <div class="lg:col-span-3 space-y-4">
            {% for phase, phaseGames in groupedGames %}
                {# Cada jornada es un acordeón. La primera empieza abierta #}
                <div x-data="{ open: {{ loop.first ? 'true' : 'false' }} }"
                    class="bg-white rounded-[2rem] shadow-sm border border-gray-100 overflow-hidden transition-all duration-300">

                    {# Cabecera del Acordeón #}
                    <button @click="open = !open"
                            class="w-full flex items-center justify-between px-8 py-5 bg-gray-50/50 hover:bg-gray-100 transition-colors group">
                        <div class="flex items-center gap-4">
                            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-indigo-600 text-white text-[10px] font-black shadow-lg shadow-indigo-100">
                                {{ loop.index }}
                            </span>
                            <h3 class="font-black text-gray-700 uppercase text-xs tracking-[0.2em]">{{ phase }}</h3>
                            <span class="text-[10px] font-bold text-gray-400">({{ phaseGames|length }} partidos)</span>
                        </div>

                        <div class="text-gray-300 group-hover:text-indigo-600 transition-transform duration-300"
                            :class="open ? 'rotate-180' : ''">
                            <i class="fas fa-chevron-down text-xs"></i>
                        </div>
                    </button>

                    {# Lista de Partidos #}
                    <div x-show="open"
                        x-collapse
                        class="border-t border-gray-50">
                        <ul class="divide-y divide-gray-50">
                            {% for game in phaseGames %}
                                <li class="p-6 hover:bg-gray-50/30 transition border-l-4 {{ game.score is not empty ? 'border-green-500' : 'border-transparent' }}">
                                    <div class="flex flex-wrap items-center justify-between gap-6">
                                        <div class="flex items-center space-x-4 md:space-x-8 text-center flex-1 justify-center md:justify-start">

                                            {# Pareja Local #}
                                            <div class="w-40">
                                                {% if game.team1 %}
                                                    <p class="font-black text-gray-900 uppercase text-xs tracking-tight">{{ game.team1.player1.name }}</p>
                                                    <p class="font-bold text-indigo-500 uppercase text-[10px] tracking-tight">{{ game.team1.player2.name }}</p>
                                                {% else %}
                                                    <p class="text-gray-400 italic text-xs font-bold">TBD</p>
                                                {% endif %}
                                            </div>

                                            {# Marcador Central #}
                                            <div class="flex flex-col items-center justify-center min-w-[120px]">
                                                {% if game.score %}
                                                    <div class="bg-gray-900 text-white px-4 py-2 rounded-xl shadow-md font-mono text-lg tracking-widest border-b-2 border-indigo-500">
                                                        {{ game.score }}
                                                    </div>
                                                    <span class="text-[8px] uppercase font-black text-green-500 mt-2 tracking-widest">✓ Finalizado</span>
                                                {% else %}
                                                    <div class="text-indigo-200 font-black text-2xl italic px-4">VS</div>
                                                    <span class="text-[8px] uppercase font-black text-gray-400 mt-1 tracking-widest">Pendiente</span>
                                                {% endif %}
                                            </div>

                                            {# Pareja Visitante #}
                                            <div class="w-40">
                                                {% if game.team2 %}
                                                    <p class="font-black text-gray-900 uppercase text-xs tracking-tight">{{ game.team2.player1.name }}</p>
                                                    <p class="font-bold text-indigo-500 uppercase text-[10px] tracking-tight">{{ game.team2.player2.name }}</p>
                                                {% else %}
                                                    <p class="text-gray-400 italic text-xs font-bold">TBD</p>
                                                {% endif %}
                                            </div>
                                        </div>

                                        {# Info Pista #}
                                        <div class="text-[10px] text-gray-400 bg-gray-50/50 px-4 py-3 rounded-2xl border border-gray-100 flex flex-col gap-1 min-w-[120px]">
                                            <p class="font-bold"><span class="text-gray-300 uppercase">Pista:</span> {{ game.court|default('N/A') }}</p>
                                            <p class="font-bold"><span class="text-gray-300 uppercase">Hora:</span> {{ game.date ? game.date|date('H:i d/m') : 'Pendiente' }}</p>
                                        </div>

                                        {# Acciones Admin #}
                                        <div class="flex items-center gap-2">
                                            <a href="{{ path('app_admin_game_edit', {id: tournament.id, gameId: game.id}) }}"
                                            class="inline-flex items-center px-4 py-2 bg-white border border-gray-200 shadow-sm text-[10px] font-black rounded-xl text-gray-700 hover:bg-indigo-600 hover:text-white hover:border-indigo-600 transition-all uppercase tracking-widest">
                                                Resultado
                                            </a>

                                            <form method="post" action="{{ path('app_admin_game_delete', {id: tournament.id, gameId: game.id}) }}" onsubmit="return confirm('¿Borrar partido?');" class="inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.id) }}">
                                                <button class="p-2.5 text-red-200 hover:text-red-600 hover:bg-red-50 rounded-xl transition-colors">
                                                    <i class="fas fa-trash-alt text-xs"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-20 bg-white rounded-[2.5rem] border-2 border-dashed border-gray-100">
                    <i class="fas fa-calendar-times text-4xl text-gray-200 mb-4 block"></i>
                    <p class="text-gray-400 font-medium italic">No hay partidos programados aún.</p>
                </div>
            {% endfor %}
        </div>

        {# DERECHA: SIDEBAR DE PAREJAS #}
        <div class="lg:col-span-1">
            <div class="bg-gray-900 rounded-[2.5rem] p-8 shadow-2xl sticky top-8">
                <h3 class="text-white font-black uppercase tracking-widest text-[11px] mb-6 flex items-center">
                    <i class="fas fa-users-rectangle mr-2 text-indigo-400"></i> Nueva Pareja
                </h3>

                {{ form_start(teamForm, {'attr': {'class': 'space-y-4'}}) }}
                    <div class="space-y-1">
                        <label class="text-[10px] font-black text-gray-500 uppercase ml-1">Jugador 1</label>
                        {{ form_widget(teamForm.player1, {'attr': {'class': 'w-full bg-gray-800 border-0 rounded-2xl text-white text-[13px] p-4 focus:ring-2 focus:ring-indigo-500'}}) }}
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black text-gray-500 uppercase ml-1">Jugador 2</label>
                        {{ form_widget(teamForm.player2, {'attr': {'class': 'w-full bg-gray-800 border-0 rounded-2xl text-white text-[13px] p-4 focus:ring-2 focus:ring-indigo-500'}}) }}
                    </div>
                    <button class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-black py-4 rounded-2xl transition-all uppercase text-[10px] tracking-[0.2em] mt-2 shadow-lg shadow-indigo-500/20">
                        Inscribir
                    </button>
                {{ form_end(teamForm) }}

                <div class="mt-8 pt-8 border-t border-gray-800">
                    <div class="flex items-center justify-between mb-4 px-1">
                        <h3 class="text-gray-500 font-black uppercase tracking-widest text-[10px]">Inscritos</h3>
                        <span class="bg-gray-800 text-indigo-400 text-[10px] font-black px-2 py-0.5 rounded-md">{{ teams|length }}</span>
                    </div>
                    <div class="space-y-2 max-h-[300px] overflow-y-auto pr-2 custom-scrollbar">
                        {% for team in teams %}
                            <div class="bg-gray-800/40 p-3 rounded-2xl border border-gray-800/50 group hover:border-indigo-500/50 transition-colors">
                                <div class="text-[11px] font-bold text-gray-300 group-hover:text-white truncate uppercase tracking-tighter">
                                    {{ team.player1.name }}
                                </div>
                                <div class="text-[11px] font-bold text-gray-300 group-hover:text-white truncate uppercase tracking-tighter mt-1">
                                    {{ team.player2.name }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #374151; border-radius: 10px; }
</style>
{% endblock %}
