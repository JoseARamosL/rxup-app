{% extends 'base.html.twig' %}

{% block title %}Calendario - {{ tournament.name }}{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-6 md:py-10 px-4 sm:px-6 lg:px-8">

        {# Header Adaptable #}
        <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div>
                <h1 class="text-3xl font-black text-gray-900 uppercase tracking-tighter">{{ tournament.name }}</h1>
                <p class="text-gray-500 font-medium italic text-sm">Gestión de partidos y parejas oficiales</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="{{ path('app_admin_game_new', {id: tournament.id}) }}" class="flex-1 md:flex-none text-center bg-indigo-600 text-white px-5 py-3 rounded-2xl font-black hover:bg-indigo-700 transition shadow-lg shadow-indigo-100 uppercase text-[10px] tracking-widest">
                    + Nuevo Partido
                </a>
                {% if tournament.hasRanking %}
                    <a href="{{ path('app_admin_tournament_ranking', {id: tournament.id}) }}" class="flex-1 md:flex-none text-center bg-amber-400 text-black px-5 py-3 rounded-2xl font-black hover:bg-amber-500 transition shadow-lg shadow-amber-100 uppercase text-[10px] tracking-widest">
                        🏆 Ranking
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">

            {# SIDEBAR DE PAREJAS (Con Doble Acordeón) #}
            <div class="lg:col-span-1 lg:order-2">
                <div class="bg-gray-900 rounded-[2.5rem] p-6 shadow-2xl sticky top-20 overflow-hidden" x-data="{ showForm: false, showList: true }">

                    {# ACORDEÓN 1: FORMULARIO DE INSCRIPCIÓN #}
                    <div class="mb-2">
                        <button @click="showForm = !showForm"
                                class="w-full flex items-center justify-between py-3 text-indigo-400 hover:text-white transition-colors group">
                            <h3 class="font-black uppercase tracking-widest text-[11px] flex items-center">
                                <i class="fas fa-plus-circle mr-2 transition-transform duration-300" :class="showForm ? 'rotate-45 text-red-400' : ''"></i>
                                <span x-text="showForm ? 'Cerrar Registro' : 'Nueva Pareja'"></span>
                            </h3>
                            <i class="fas fa-chevron-down text-[10px] transition-transform duration-300" :class="showForm ? 'rotate-180' : ''"></i>
                        </button>

                        <div x-show="showForm" x-collapse x-cloak class="mt-2 pb-6 border-b border-gray-800">
                            {{ form_start(teamForm, {'attr': {'class': 'space-y-4'}}) }}
                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-gray-500 uppercase ml-1">Jugador 1</label>
                                {{ form_widget(teamForm.player1, {'attr': {'class': 'w-full bg-gray-800 border-0 rounded-xl text-white text-xs p-3.5 focus:ring-2 focus:ring-indigo-500'}}) }}
                            </div>
                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-gray-500 uppercase ml-1">Jugador 2</label>
                                {{ form_widget(teamForm.player2, {'attr': {'class': 'w-full bg-gray-800 border-0 rounded-xl text-white text-xs p-3.5 focus:ring-2 focus:ring-indigo-500'}}) }}
                            </div>
                            <button class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-black py-4 rounded-xl transition-all uppercase text-[10px] tracking-[0.2em] mt-2 shadow-lg shadow-indigo-500/20">
                                Inscribir
                            </button>
                            {{ form_end(teamForm) }}
                        </div>
                    </div>

                    {# ACORDEÓN 2: LISTA DE PAREJAS #}
                    <div class="pt-2">
                        <button @click="showList = !showList"
                                class="w-full flex items-center justify-between py-3 text-gray-400 hover:text-white transition-colors group">
                            <div class="flex items-center">
                                <h3 class="font-black uppercase tracking-widest text-[10px]">Parejas Inscritas</h3>
                                <span class="ml-2 bg-gray-800 text-indigo-400 text-[10px] font-black px-2 py-0.5 rounded-md">{{ teams|length }}</span>
                            </div>
                            <i class="fas fa-chevron-down text-[10px] transition-transform duration-300" :class="showList ? 'rotate-180' : ''"></i>
                        </button>

                        <div x-show="showList" x-collapse x-cloak class="mt-2">
                            <div class="space-y-2 max-h-[300px] lg:max-h-[400px] overflow-y-auto pr-2 custom-scrollbar">
                                {% for team in teams %}
                                    <div class="bg-gray-800/40 p-3 rounded-xl border border-gray-800/50 group hover:border-indigo-500/50 transition-colors">
                                        <div class="text-[10px] font-black text-gray-100 group-hover:text-white uppercase tracking-tight truncate">
                                            {{ team.player1.name }}
                                        </div>
                                        <div class="text-[10px] font-black text-gray-100 group-hover:text-white uppercase tracking-tight mt-0.5 truncate">
                                            {{ team.player2.name }}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# IZQUIERDA: CALENDARIO DE PARTIDOS #}
            <div class="lg:col-span-3 lg:order-1 space-y-4">
                {% for phase, phaseGames in groupedGames %}
                    <div x-data="{ open: {{ loop.first ? 'true' : 'false' }} }"
                         class="bg-white rounded-[2rem] shadow-sm border border-gray-100 overflow-hidden transition-all duration-300">

                        {# Cabecera del Acordeón Jornada #}
                        <button @click="open = !open"
                                class="w-full flex items-center justify-between px-6 py-5 bg-gray-50/50 hover:bg-gray-50 transition-colors group">
                            <div class="flex items-center gap-4">
                            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-indigo-600 text-white text-[10px] font-black">
                                {{ loop.index }}
                            </span>
                                <h3 class="font-black text-gray-700 uppercase text-[11px] tracking-[0.15em]">{{ phase }}</h3>
                            </div>
                            <i class="fas fa-chevron-down text-gray-300 text-xs transition-transform duration-300" :class="open ? 'rotate-180' : ''"></i>
                        </button>

                        {# Lista de Partidos #}
                        <div x-show="open" x-collapse class="border-t border-gray-50">
                            <ul class="divide-y divide-gray-50">
                                {% for game in phaseGames %}
                                    <li class="p-4 md:p-6 hover:bg-gray-50/30 transition border-l-4 {{ game.score is not empty ? 'border-green-500' : 'border-transparent' }}">
                                        <div class="flex flex-col md:flex-row items-center justify-between gap-6">

                                            <div class="flex items-center justify-between w-full md:w-auto md:justify-start md:space-x-8 text-center">
                                                {# Pareja Local #}
                                                <div class="flex-1 md:w-40">
                                                    {% if game.team1 %}
                                                        <p class="font-black text-gray-900 uppercase text-[10px] md:text-xs tracking-tight">{{ game.team1.player1.name }}</p>
                                                        <p class="font-black text-gray-900 uppercase text-[10px] md:text-xs tracking-tight">{{ game.team1.player2.name }}</p>
                                                    {% else %}
                                                        <p class="text-gray-400 italic text-xs">TBD</p>
                                                    {% endif %}
                                                </div>

                                                <div class="flex flex-col items-center px-4">
                                                    {% if game.score %}
                                                        <div class="bg-gray-900 text-white px-3 py-1.5 rounded-xl shadow-md font-mono text-base md:text-lg border-b-2 border-indigo-500">
                                                            {{ game.score }}
                                                        </div>
                                                    {% else %}
                                                        <div class="text-indigo-100 font-black text-xl italic">VS</div>
                                                    {% endif %}
                                                </div>

                                                {# Pareja Visitante #}
                                                <div class="flex-1 md:w-40">
                                                    {% if game.team2 %}
                                                        <p class="font-black text-gray-900 uppercase text-[10px] md:text-xs tracking-tight">{{ game.team2.player1.name }}</p>
                                                        <p class="font-black text-gray-900 uppercase text-[10px] md:text-xs tracking-tight">{{ game.team2.player2.name }}</p>
                                                    {% else %}
                                                        <p class="text-gray-400 italic text-xs">TBD</p>
                                                    {% endif %}
                                                </div>
                                            </div>

                                            <div class="flex items-center justify-between w-full md:w-auto gap-4">
                                                <div class="text-[9px] text-gray-400 font-bold uppercase tracking-widest bg-gray-50 px-3 py-2 rounded-xl border border-gray-100">
                                                    {{ game.court|default('Pista TBD') }} • {{ game.date ? game.date|date('H:i d/m') : 'Hora TBD' }}
                                                </div>

                                                <div class="flex items-center gap-2">
                                                    <a href="{{ path('app_admin_game_edit', {id: tournament.id, gameId: game.id}) }}"
                                                       class="bg-white border border-gray-200 p-2 md:px-4 md:py-2 rounded-xl text-gray-700 hover:bg-indigo-600 hover:text-white transition-all">
                                                        <i class="fas fa-edit md:hidden"></i>
                                                        <span class="hidden md:inline text-[10px] font-black uppercase tracking-widest">Resultado</span>
                                                    </a>

                                                    <form method="post" action="{{ path('app_admin_game_delete', {id: tournament.id, gameId: game.id}) }}" onsubmit="return confirm('¿Borrar?');" class="inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.id) }}">
                                                        <button class="p-2 text-red-200 hover:text-red-500 transition-colors">
                                                            <i class="fas fa-trash-alt text-xs"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% else %}
                    <div class="text-center py-20 bg-white rounded-[2.5rem] border-2 border-dashed border-gray-100">
                        <p class="text-gray-400 font-medium italic">No hay partidos programados.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <style>
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #374151; border-radius: 10px; }
    </style>
{% endblock %}
