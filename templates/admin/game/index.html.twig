{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ tournament.name }} — RXUP Admin{% endblock %}
{% block page_title_mobile %}{{ tournament.name }}{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.min.css" rel="stylesheet">
    <style>
        .ts-wrapper.single .ts-control { border-radius: 0.5rem; border: 1px solid #d1d5db; padding: 0.5rem 0.75rem; font-size: 0.875rem; box-shadow: none; }
        .ts-wrapper.single.focus .ts-control { border-color: #111827; box-shadow: 0 0 0 1px #111827; }
        .ts-dropdown { border: 1px solid #e5e7eb; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); font-size: 0.875rem; }
        .ts-dropdown .option { padding: 0.5rem 0.75rem; }
        .ts-dropdown .option:hover, .ts-dropdown .option.active { background: #f3f4f6; color: #111827; }
    </style>
{% endblock %}

{% block body %}
    <div class="max-w-6xl mx-auto">

        {# Cabecera #}
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <a href="{{ path('app_admin_tournament_index') }}"
                   class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-1">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                    Torneos
                </a>
                <h1 class="text-xl font-semibold text-gray-900">{{ tournament.name }}</h1>
                <p class="text-sm text-gray-500 mt-0.5">Gestión de partidos</p>
            </div>
            <div class="flex items-center gap-2">
                {% if tournament.type == 'LEAGUE' %}
                    <a href="{{ path('app_admin_availability_index', {id: tournament.id}) }}"
                       class="inline-flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                        <i class="fa-solid fa-calendar-check text-xs text-blue-500"></i>
                        Disponibilidades
                    </a>
                {% endif %}
                {% if tournament.hasRanking %}
                    <a href="{{ path('app_admin_tournament_ranking', {id: tournament.id}) }}"
                       class="inline-flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                        <i class="fa-solid fa-trophy text-xs text-amber-500"></i>
                        Ranking
                    </a>
                {% endif %}
                <a href="{{ path('app_admin_game_new', {id: tournament.id}) }}"
                   class="inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors">
                    <i class="fa-solid fa-plus text-xs"></i>
                    Nuevo partido
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

            {# Columna derecha: Parejas #}
            <div class="lg:col-span-1 lg:order-2 space-y-4">

                {# Formulario nueva pareja #}
                <div class="rounded-xl border border-gray-200 bg-white overflow-hidden" x-data="{ open: false }">
                    <button @click="open = !open"
                            class="flex w-full items-center justify-between px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-user-plus text-xs text-gray-400"></i>
                            Nueva pareja
                        </span>
                        <i class="fa-solid fa-chevron-down text-xs text-gray-400 transition-transform duration-200" :class="open ? 'rotate-180' : ''"></i>
                    </button>
                    <div x-show="open" x-collapse x-cloak class="border-t border-gray-100 px-4 py-4">
                        {{ form_start(teamForm, {'attr': {'class': 'space-y-3'}}) }}
                            <div>
                                <label class="block text-xs font-medium text-gray-600 mb-1">Jugador 1</label>
                                {{ form_widget(teamForm.player1) }}
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-600 mb-1">Jugador 2</label>
                                {{ form_widget(teamForm.player2) }}
                            </div>
                            <button type="submit"
                                    class="w-full rounded-lg bg-gray-900 px-3 py-2 text-xs font-medium text-white hover:bg-gray-700 transition-colors">
                                Inscribir pareja
                            </button>
                        {{ form_end(teamForm) }}
                    </div>
                </div>

                {# Lista de parejas #}
                <div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
                        <span class="text-sm font-medium text-gray-700">Parejas</span>
                        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500">{{ teams|length }}</span>
                    </div>
                    {% if teams is empty %}
                        <p class="px-4 py-6 text-center text-xs text-gray-400">Sin parejas inscritas</p>
                    {% else %}
                        <ul class="divide-y divide-gray-100 max-h-80 overflow-y-auto">
                            {% for team in teams %}
                                <li class="flex items-center gap-3 px-4 py-3">
                                    <div class="flex -space-x-1.5 shrink-0">
                                        <div class="h-6 w-6 rounded-full bg-blue-500 border-2 border-white flex items-center justify-center text-white text-[9px] font-semibold">
                                            {{ team.player1.name|slice(0,1)|upper }}
                                        </div>
                                        <div class="h-6 w-6 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center text-white text-[9px] font-semibold">
                                            {{ team.player2.name|slice(0,1)|upper }}
                                        </div>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-xs font-medium text-gray-800 truncate">{{ team.player1.name }}</p>
                                        <p class="text-xs text-gray-400 truncate">{{ team.player2.name }}</p>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>

            </div>

            {# Columna izquierda: Partidos por jornada #}
            <div class="lg:col-span-3 lg:order-1 space-y-4">
                {% if groupedGames is empty %}
                    <div class="rounded-xl border border-gray-200 bg-white flex flex-col items-center justify-center py-16 text-center">
                        <i class="fa-solid fa-calendar text-3xl text-gray-300 mb-3"></i>
                        <p class="text-sm font-medium text-gray-500">No hay partidos programados</p>
                        <p class="text-xs text-gray-400 mt-1">Crea el primero con el botón de arriba</p>
                    </div>
                {% else %}
                    {% for phase, phaseGames in groupedGames %}
                        <div class="rounded-xl border border-gray-200 bg-white overflow-hidden"
                             x-data="{ open: {{ loop.first ? 'true' : 'false' }} }">

                            {# Cabecera jornada #}
                            <button @click="open = !open"
                                    class="flex w-full items-center justify-between px-5 py-4 hover:bg-gray-50 transition-colors">
                                <div class="flex items-center gap-3">
                                    <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gray-900 text-xs font-semibold text-white">
                                        {{ loop.index }}
                                    </span>
                                    <span class="text-sm font-medium text-gray-900">{{ phase }}</span>
                                    <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">{{ phaseGames|length }}</span>
                                </div>
                                <i class="fa-solid fa-chevron-down text-xs text-gray-400 transition-transform duration-200" :class="open ? 'rotate-180' : ''"></i>
                            </button>

                            {# Lista de partidos #}
                            <div x-show="open" x-collapse class="border-t border-gray-100">
                                <ul class="divide-y divide-gray-100">
                                    {% for game in phaseGames %}
                                        <li class="px-5 py-4 {{ game.score is not empty ? 'border-l-4 border-emerald-400' : 'border-l-4 border-transparent' }}">
                                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">

                                                {# Enfrentamiento #}
                                                <div class="flex items-center gap-3 flex-1 min-w-0">
                                                    <div class="text-right min-w-0 flex-1">
                                                        {% if game.team1 %}
                                                            <p class="text-sm font-medium text-gray-900 truncate">{{ game.team1.player1.name }}</p>
                                                            <p class="text-xs text-gray-400 truncate">{{ game.team1.player2.name }}</p>
                                                        {% else %}
                                                            <p class="text-sm text-gray-300">TBD</p>
                                                        {% endif %}
                                                    </div>

                                                    <div class="shrink-0 text-center">
                                                        {% if game.score %}
                                                            <span class="inline-block rounded-lg bg-gray-900 px-3 py-1 text-xs font-semibold text-white font-mono">
                                                                {{ game.score }}
                                                            </span>
                                                        {% else %}
                                                            <span class="text-sm font-medium text-gray-300">vs</span>
                                                        {% endif %}
                                                    </div>

                                                    <div class="text-left min-w-0 flex-1">
                                                        {% if game.team2 %}
                                                            <p class="text-sm font-medium text-gray-900 truncate">{{ game.team2.player1.name }}</p>
                                                            <p class="text-xs text-gray-400 truncate">{{ game.team2.player2.name }}</p>
                                                        {% else %}
                                                            <p class="text-sm text-gray-300">TBD</p>
                                                        {% endif %}
                                                    </div>
                                                </div>

                                                {# Info + acciones #}
                                                <div class="flex items-center gap-2 shrink-0">
                                                    <span class="hidden sm:inline-block rounded-md bg-gray-50 border border-gray-200 px-2.5 py-1 text-xs text-gray-500">
                                                        {{ game.court|default('Pista TBD') }} · {{ game.date ? game.date|date('H:i d/m') : 'TBD' }}
                                                    </span>
                                                    <a href="{{ path('app_admin_game_edit', {id: tournament.id, gameId: game.id}) }}"
                                                       class="rounded-md border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                                                        Resultado
                                                    </a>
                                                    <form method="post" action="{{ path('app_admin_game_delete', {id: tournament.id, gameId: game.id}) }}"
                                                          onsubmit="return confirm('¿Eliminar este partido?');" class="inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.id) }}">
                                                        <button type="submit"
                                                                class="rounded-md border border-gray-200 p-1.5 text-gray-400 hover:text-red-600 hover:border-red-200 hover:bg-red-50 transition-colors">
                                                            <i class="fa-solid fa-trash-alt text-xs"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script>
        document.querySelectorAll('select').forEach(function(el) {
            new TomSelect(el, { placeholder: 'Buscar jugador...', searchField: ['text'], maxOptions: null });
        });
    </script>
{% endblock %}
