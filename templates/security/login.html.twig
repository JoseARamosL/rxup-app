{% extends 'base.html.twig' %}

{% block title %}Acceso - RXUP{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-[#0f0f0f] py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
        {# Elementos decorativos de fondo #}
        <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
            <div class="absolute top-[-10%] right-[-5%] w-96 h-96 bg-[#e63946] rounded-full blur-[120px]"></div>
            <div class="absolute bottom-[-10%] left-[-5%] w-96 h-96 bg-[#e2d9c2] opacity-20 rounded-full blur-[120px]"></div>
        </div>

        <div class="max-w-md w-full space-y-8 bg-[#1a1a1a] p-10 rounded-[2.5rem] shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/5 relative z-10">
            {# Logo RXUP #}
            <div class="text-center">
                <div class="mx-auto h-20 w-20 mb-6 relative">
                    <div class="absolute inset-0 border-2 border-[#e63946] rounded-full animate-pulse"></div>
                    <div class="flex items-center justify-center h-full">
                        <i class="fas fa-bolt text-[#e63946] text-3xl"></i>
                    </div>
                </div>

                <h2 class="text-4xl font-black text-[#e2d9c2] tracking-tighter uppercase italic">
                    RX<span class="text-[#e63946]">UP</span>
                </h2>
                <p class="mt-2 text-[10px] font-black text-gray-500 uppercase tracking-[0.3em]">
                    Tu límite no tiene marca
                </p>
            </div>

            <form class="mt-10 space-y-6" method="post" id="login-form">
                {% if error %}
                    <div class="bg-red-950/30 border-l-4 border-[#e63946] p-4 mb-4 rounded-xl">
                        <p class="text-[10px] font-bold text-red-400 uppercase tracking-tight">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </p>
                    </div>
                {% endif %}

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="space-y-5">
                    {# Email o Teléfono #}
                    <div class="group">
                        <label for="inputIdentifier" class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2 ml-1">Email o Teléfono</label>
                        <div class="relative">
                        <span class="absolute inset-y-0 left-4 flex items-center text-gray-500 group-focus-within:text-[#e63946] transition-colors">
                            <i class="fas fa-user-ninja"></i>
                        </span>
                            <input type="text" value="{{ last_username }}" name="_username" id="inputIdentifier"
                                   class="block w-full pl-12 pr-4 py-4 bg-[#252525] border-0 rounded-2xl text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] transition-all outline-none placeholder-gray-600 font-bold text-sm"
                                   placeholder="600123456" required autofocus>
                        </div>
                    </div>

                    {# Contraseña Admin (Oculta por defecto) #}
                    <div id="password-container" class="hidden transform transition-all duration-500 origin-top scale-95 opacity-0 group">
                        <label for="inputPassword" class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2 ml-1">Contraseña Admin</label>
                        <div class="relative">
                        <span class="absolute inset-y-0 left-4 flex items-center text-gray-500 group-focus-within:text-[#e63946] transition-colors">
                            <i class="fas fa-lock"></i>
                        </span>
                            <input type="password" name="_password" id="inputPassword"
                                   class="block w-full pl-12 pr-4 py-4 bg-[#252525] border-0 rounded-2xl text-[#e2d9c2] focus:ring-2 focus:ring-[#e63946] transition-all outline-none font-bold text-sm"
                                   placeholder="••••••••">
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between px-1">
                    <div class="flex items-center">
                        <input id="remember_me" name="_remember_me" type="checkbox" class="h-4 w-4 text-[#e63946] focus:ring-[#e63946] border-white/10 bg-[#252525] rounded cursor-pointer">
                        <label for="remember_me" class="ml-2 block text-[10px] font-black text-gray-400 uppercase tracking-widest cursor-pointer">Recordarme</label>
                    </div>
                </div>

                <button type="submit" class="w-full flex justify-center items-center py-5 px-4 rounded-2xl text-xs font-black text-white bg-[#e63946] hover:bg-[#ff4d5a] transition-all uppercase tracking-[0.3em] shadow-[0_10px_30px_rgba(230,57,70,0.3)] group">
                    <span>Entrar</span>
                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                </button>
            </form>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const identifierInput = document.getElementById('inputIdentifier');
            const passwordContainer = document.getElementById('password-container');
            const passwordInput = document.getElementById('inputPassword');
            const form = document.getElementById('login-form');

            // Función para verificar el estado del usuario (Admin o Jugador)
            const checkUserType = async (identifier) => {
                if (identifier.length < 3) return { isAdmin: false };
                try {
                    const response = await fetch(`/check-user/${encodeURIComponent(identifier)}`);
                    return await response.json();
                } catch (e) {
                    console.error("Error en la comprobación");
                    return { isAdmin: false };
                }
            };

            // Actualiza la interfaz visualmente
            const updateUI = (isAdmin) => {
                if (isAdmin) {
                    passwordContainer.classList.remove('hidden');
                    // Un pequeño delay para que la transición de Tailwind se vea
                    setTimeout(() => {
                        passwordContainer.classList.remove('scale-95', 'opacity-0');
                        passwordContainer.classList.add('scale-100', 'opacity-100');
                    }, 10);
                    passwordInput.setAttribute('required', 'required');
                    if (passwordInput.value === 'nopassword') passwordInput.value = '';
                } else {
                    passwordContainer.classList.add('hidden', 'scale-95', 'opacity-0');
                    passwordInput.removeAttribute('required');
                    passwordInput.value = 'nopassword';
                }
            };

            // Comprobar cuando el usuario deja de escribir en el campo
            identifierInput.addEventListener('blur', async () => {
                const data = await checkUserType(identifierInput.value.trim());
                updateUI(data.isAdmin);
            });

            // CONTROL TOTAL DEL ENVÍO
            form.addEventListener('submit', async (e) => {
                // 1. Detenemos el envío automático del navegador
                e.preventDefault();

                const identifier = identifierInput.value.trim();
                if (!identifier) return;

                // 2. Comprobamos el estado real en el servidor antes de seguir
                const data = await checkUserType(identifier);
                updateUI(data.isAdmin);

                // 3. Lógica de decisión
                if (data.isAdmin) {
                    // Si es admin y no ha puesto contraseña o tiene la de jugador, frenamos y pedimos clave
                    if (passwordInput.value === '' || passwordInput.value === 'nopassword') {
                        passwordInput.focus();
                        return; // No se envía el formulario
                    }
                } else {
                    // Si es jugador, nos aseguramos de que lleve 'nopassword'
                    passwordInput.value = 'nopassword';
                }

                // 4. Si todo está correcto, enviamos el formulario manualmente
                form.submit();
            });
        });
    </script>
{% endblock %}
